---
const menuItems = [
  { name: "HOME", href: "/" },
  { name: "ABOUT", href: "/about/" },
  { name: "WORKS", href: "/works/" },
  { name: "PROFILE", href: "/profile/" },
  { name: "ACHIEVEMENTS", href: "/achievements/" },
  { name: "CONTACT", href: "/contact/" },
];
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-[100] transition-all duration-500"
>

  <div
    class="
      mx-auto
      flex
      max-w-[1800px]
      items-center
      justify-between
      px-10
      py-8

      max-sm:px-5
      max-sm:py-5
    "
  >

    <!-- Logo -->
    <a
      href="/"
      id="header-logo"
      class="
        flex
        shrink-0
        items-center
      "
    >

      <img
        src="/images/logo.webp"
        alt="錦乃"
        draggable="false"
        class="
          h-16
          w-auto
          transition
          duration-500
          hover:scale-105

          max-sm:h-12
        "
      />

    </a>


    <!-- Navigation -->
    <nav
      id="desktop-nav"
      class="
        ml-auto
        flex
        items-center
        gap-8

        font-['Cormorant_Garamond']

        text-white

        transition-all
        duration-700

        xl:gap-12

        max-sm:ml-0
        max-sm:mr-2
        max-sm:grid
        max-sm:w-[210px]
        max-sm:shrink-0
        max-sm:grid-cols-3
        max-sm:gap-x-2
        max-sm:gap-y-2
        max-sm:text-center
      "
    >

      {
        menuItems.map((item) => (
          <a
            href={item.href}
            class="
              header-link

              whitespace-nowrap

              text-[17px]

              tracking-[0.16em]

              transition
              duration-300

              hover:text-[#f8dfc1]

              xl:text-[17px]
              xl:tracking-[0.18em]

              max-sm:w-full
              max-sm:text-[9px]
              max-sm:tracking-[0.08em]
              max-sm:pb-0
            "
          >
            {item.name}
          </a>
        ))
      }

    </nav>


    <!-- Menu -->
    <button
      id="menu-toggle"
      type="button"
      aria-label="Toggle Navigation"
      class="
        ml-4

        flex

        h-12
        w-12

        shrink-0

        items-center
        justify-center

        max-sm:ml-0
        max-sm:h-10
        max-sm:w-10
      "
    >

      <div
        class="
          flex
          flex-col
          gap-2
        "
      >

        <span
          class="
            block
            h-px
            w-7
            bg-white

            max-sm:w-6
          "
        ></span>

        <span
          class="
            block
            h-px
            w-7
            bg-white

            max-sm:w-6
          "
        ></span>

        <span
          class="
            block
            h-px
            w-7
            bg-white

            max-sm:w-6
          "
        ></span>

      </div>

    </button>

  </div>

</header>


<style>

#desktop-nav{

  transition:
    opacity .7s ease,
    transform .7s ease;

}


.header-hidden{

  opacity:0;

  pointer-events:none;

  transform:translateX(40px);

}


/* -------------------------
   PC Header Ornament
-------------------------- */

.header-link{

  position:relative;

  display:inline-flex;

  justify-content:center;

  padding-bottom:12px;

}


/* 和風文様 */

.header-link::after{

  content:"";

  position:absolute;

  left:50%;
  bottom:-28px;

  width:90px;
  height:80px;

  transform:
    translateX(-50%)
    translateY(4px);

  opacity:0;

  background:
    url("/images/header-ornament.png")
    center/contain
    no-repeat;

  transition:
    opacity .35s ease, 
    transform .35s ease;

  pointer-events:none;

}


/* PC Hover */

.header-link:hover::after,
.header-link:focus-visible::after{

  opacity:1;

  transform:
    translateX(-50%)
    translateY(0);

}


/* タップ時 */

.header-link:active::after{

  opacity:1;

  transform:
    translateX(-50%)
    translateY(0);

}


/* -------------------------
   Smartphone
-------------------------- */

@media (max-width: 639px){

  .header-link::after{

    display:none;

  }

  #desktop-nav{

    width:210px;

    min-width:210px;
    max-width:210px;

    flex-shrink:0;

    display:grid;

    grid-template-columns:
      repeat(3, minmax(0, 1fr));

    grid-template-rows:
      repeat(2, auto);

    column-gap:8px;
    row-gap:8px;

  }

}

</style>


<script is:inline>

function initHeader(){

  const header =
    document.getElementById("site-header");


  const desktop =
    document.getElementById("desktop-nav");


  const toggle =
    document.getElementById("menu-toggle");


  if(
    !header ||
    !desktop ||
    !toggle
  ) return;


  if(toggle.dataset.ready)
    return;


  toggle.dataset.ready="true";


  let menuOpen=false;


  toggle.addEventListener(
    "click",
    ()=>{

      menuOpen=!menuOpen;


      if(menuOpen){

        desktop.classList.add(
          "header-hidden"
        );

      }else{

        desktop.classList.remove(
          "header-hidden"
        );

      }

    }
  );


  const scrollHandler=()=>{

    if(window.scrollY>40){

      header.classList.add(
        "bg-[#201710]/35",
        "backdrop-blur-xl",
        "shadow-lg"
      );

    }else{

      header.classList.remove(
        "bg-[#201710]/35",
        "backdrop-blur-xl",
        "shadow-lg"
      );

    }

  };


  scrollHandler();


  window.addEventListener(
    "scroll",
    scrollHandler,
    {
      passive:true
    }
  );

}


initHeader();


document.addEventListener(
  "astro:page-load",
  initHeader
);

</script>