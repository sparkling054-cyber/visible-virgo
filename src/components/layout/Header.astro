---
const menuItems = [
  { name: "HOME", href: "/" },
  { name: "ABOUT", href: "/about/" },
  { name: "WORKS", href: "/works/" },
  { name: "PROFILE", href: "/profile/" },
  { name: "ACHIEVEMENTS", href: "/achievements/" },
  { name: "CONTACT", href: "/contact/" },
];
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-[100] transition-all duration-500"
>

  <div
    class="
      mx-auto
      flex
      max-w-[1800px]
      items-center
      justify-between
      px-10
      py-8
    "
  >

    <!-- Logo -->
    <a
      href="/"
      id="header-logo"
      class="
        flex
        shrink-0
        items-center
      "
    >

      <img
        src="/images/logo.webp"
        alt="錦乃"
        draggable="false"
        class="
          h-16
          w-auto
          transition
          duration-500
          hover:scale-105
        "
      />

    </a>


    <!-- Navigation -->
    <nav
      id="desktop-nav"
      class="
        ml-auto
        flex
        items-center
        gap-8

        font-['Cormorant_Garamond']

        text-white

        transition-all
        duration-700

        xl:gap-12
      "
    >

      {
        menuItems.map((item) => (
          <a
            href={item.href}
            class="
              header-link

              whitespace-nowrap

              text-[17px]

              tracking-[0.16em]

              transition
              duration-300

              hover:text-[#f8dfc1]

              xl:text-[17px]
              xl:tracking-[0.18em]
            "
          >
            {item.name}
          </a>
        ))
      }

    </nav>


        <!-- Menu -->
    <button
      id="menu-toggle"
      type="button"
      aria-label="Toggle Navigation"
      aria-expanded="false"
      class="
        ml-4
        flex
        h-12
        w-12
        shrink-0
        flex-col
        items-center
        justify-center
      "
    >

      <!-- Hamburger -->
      <div
        id="hamburger"
      >

        <span></span>
        <span></span>
        <span></span>

      </div>

      <!-- OPEN / CLOSE -->
      <span
        id="menu-state"
        aria-hidden="true"
      >
        OPEN
      </span>

    </button>

  </div>

</header>


<style>

#desktop-nav{

  transition:
    opacity .7s ease,
    transform .7s ease;

}


.header-hidden{

  opacity:0;

  pointer-events:none;

  transform:translateX(40px);

}


/* -------------------------
   PC Header Ornament
-------------------------- */

.header-link{

  position:relative;

  display:inline-flex;

  justify-content:center;

  padding-bottom:12px;

}


/* 和風文様 */

.header-link::after{

  content:"";

  position:absolute;

  left:50%;
  bottom:-28px;

  width:90px;
  height:80px;

  transform:
    translateX(-50%)
    translateY(4px);

  opacity:0;

  background:
    url("/images/header-ornament.png")
    center/contain
    no-repeat;

  transition:
    opacity .35s ease,
    transform .35s ease;

  pointer-events:none;

}


/* PC Hover */

.header-link:hover::after,
.header-link:focus-visible::after{

  opacity:1;

  transform:
    translateX(-50%)
    translateY(0);

}


/* タップ時 */

.header-link:active::after{

  opacity:1;

  transform:
    translateX(-50%)
    translateY(0);

}

/* -------------------------
   Menu State
-------------------------- */

#menu-state{
  display:none;
}


/* -------------------------
   Smartphone
-------------------------- */

@media (max-width:639px){

  #site-header{
    background:transparent !important;
  }


  #site-header > div{
    padding-left:20px;
    padding-right:20px;
    padding-top:18px;
    padding-bottom:18px;
  }


  /* Logo */

  #header-logo img{
    height:48px;
  }


  /* Navigation */

  #desktop-nav{

    position:fixed;

    top:92px;
    right:20px;

    margin:0;

    display:flex;
    flex-direction:column;
    align-items:flex-end;

    gap:18px;

    padding:0;

    background:transparent !important;

    backdrop-filter:none !important;
    -webkit-backdrop-filter:none !important;

    box-shadow:none !important;

    opacity:1;

    transform:none;

    pointer-events:auto;

    transition:
      opacity .35s ease,
      transform .35s ease;

  }


  #desktop-nav.header-hidden{

    opacity:0;

    pointer-events:none;

    transform:translateY(-10px);

  }


  #desktop-nav .header-link{

    padding-bottom:0;

    font-size:15px;

    line-height:1;

    letter-spacing:.16em;

  }


  /* -------------------------
     Hamburger Button
  -------------------------- */

  #menu-toggle{

    position:relative;

    display:flex !important;

    width:52px !important;
    height:64px !important;

    margin-left:auto;

    padding:0 !important;

    flex-shrink:0;

    flex-direction:column !important;

    align-items:center !important;
    justify-content:center !important;

    gap:6px !important;

    background:transparent !important;

    border:0 !important;

    color:white !important;

    visibility:visible !important;

    opacity:1 !important;

  }


  /* 三本バー */

  #hamburger{

    display:flex !important;

    width:27px !important;

    height:15px !important;

    flex-direction:column !important;

    align-items:stretch !important;

    justify-content:space-between !important;

    gap:0 !important;

    visibility:visible !important;

    opacity:1 !important;

  }


  #hamburger span{

    display:block !important;

    width:27px !important;

    height:1px !important;

    min-height:1px !important;

    flex:none !important;

    background:#ffffff !important;

    visibility:visible !important;

    opacity:1 !important;

  }


  /* OPEN / CLOSE */

  #menu-state{

    display:block !important;

    font-family:
      "Cormorant Garamond",
      serif;

    font-size:9px;

    line-height:1;

    letter-spacing:.18em;

    color:#ffffff !important;

    white-space:nowrap;

    visibility:visible !important;

    opacity:1 !important;

  }


  /* スマホでは装飾を非表示 */

  .header-link::after{
    display:none !important;
  }

}


/* -------------------------
   Smartphone Menu Open
-------------------------- */

@media (max-width:639px){

  #menu-toggle.menu-open #menu-state{

    font-size:9px;

  }

}

</style>


<script is:inline>

function initHeader(){

  const header =
    document.getElementById("site-header");


  const desktop =
    document.getElementById("desktop-nav");


  const toggle =
    document.getElementById("menu-toggle");


  const menuState =
    document.getElementById("menu-state");


  if(
    !header ||
    !desktop ||
    !toggle ||
    !menuState
  ) return;


  if(toggle.dataset.ready)
    return;


  toggle.dataset.ready="true";


  let menuOpen=false;


  const updateMenuState=()=>{

    toggle.setAttribute(
      "aria-expanded",
      String(menuOpen)
    );


    toggle.classList.toggle(
      "menu-open",
      menuOpen
    );


    menuState.textContent =
      menuOpen
        ? "CLOSE"
        : "OPEN";


    if(menuOpen){

      desktop.classList.remove(
        "header-hidden"
      );

    }else{

      desktop.classList.add(
        "header-hidden"
      );

    }

  };


  toggle.addEventListener(
    "click",
    ()=>{

      menuOpen=!menuOpen;

      updateMenuState();

    }
  );


  /*
   * 初期状態
   */
  updateMenuState();


  const scrollHandler=()=>{

    if(window.scrollY>40){

      header.classList.add(
        "bg-[#201710]/35",
        "backdrop-blur-xl",
        "shadow-lg"
      );

    }else{

      header.classList.remove(
        "bg-[#201710]/35",
        "backdrop-blur-xl",
        "shadow-lg"
      );

    }

  };


  scrollHandler();


  window.addEventListener(
    "scroll",
    scrollHandler,
    {
      passive:true
    }
  );

}


initHeader();


document.addEventListener(
  "astro:page-load",
  initHeader
);

</script>
