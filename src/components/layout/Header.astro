
---
const menuItems = [
  { name: "HOME", href: "/" },
  { name: "ABOUT", href: "/about/" },
  { name: "WORKS", href: "/works/" },
  { name: "PROFILE", href: "/profile/" },
  { name: "ACHIEVEMENTS", href: "/achievements/" },
  { name: "CONTACT", href: "/contact/" },
];
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-[100] transition-all duration-500"
>

  <div
    class="
      mx-auto
      flex
      max-w-[1800px]
      items-center
      justify-between
      px-3
      py-4
      sm:px-6
      sm:py-7
      lg:px-10
      lg:py-8
    "
  >

    <!-- Logo -->
    <a
      href="/"
      id="header-logo"
      class="
        flex
        shrink-0
        items-center
      "
    >

      <img
        src="/images/logo.webp"
        alt="錦乃"
        draggable="false"
        class="
          h-10
          w-auto
          transition
          duration-500
          hover:scale-105

          sm:h-24
          lg:h-28
        "
      />

    </a>


    <!-- PC Navigation -->
    <nav
      id="desktop-nav"
      class="
        hidden
        ml-auto
        items-center
        font-['Cormorant_Garamond']
        text-white
        transition-all
        duration-700
        sm:flex
        gap-5
        lg:gap-8
        xl:gap-12
      "
    >

      {
        menuItems.map((item)=>(
          <a
            href={item.href}
            class="
              header-link
              whitespace-nowrap
              text-[14px]
              tracking-[0.16em]
              transition
              duration-300
              hover:text-[#f8dfc1]
              lg:text-[17px]
              xl:text-[17px]
              xl:tracking-[0.18em]
            "
          >
            {item.name}
          </a>
        ))
      }

    </nav>


    <!-- Smartphone Navigation -->
    <nav
      id="mobile-nav"
      class="
        grid
        grid-cols-2
        gap-x-3
        gap-y-1
        font-['Cormorant_Garamond']
        text-white
        transition-all
        duration-700
        sm:hidden
      "
    >

      <a href="/" class="mobile-link">
        HOME
      </a>

      <a href="/about/" class="mobile-link">
        ABOUT
      </a>

      <a href="/works/" class="mobile-link">
        WORKS
      </a>

      <a href="/profile/" class="mobile-link">
        PROFILE
      </a>

      <a href="/achievements/" class="mobile-link">
        ACHIEVEMENTS
      </a>

      <a href="/contact/" class="mobile-link">
        CONTACT
      </a>

    </nav>


    <!-- Menu -->
    <button
      id="menu-toggle"
      type="button"
      aria-label="Toggle Navigation"
      class="
        ml-2
        flex
        h-9
        w-9
        shrink-0
        items-center
        justify-center
        sm:ml-4
        sm:h-12
        sm:w-12
      "
    >

      <div
        class="
          flex
          flex-col
          gap-1.5
          sm:gap-2
        "
      >

        <span
          class="
            block
            h-px
            w-5
            bg-white
            sm:w-7
          "
        ></span>

        <span
          class="
            block
            h-px
            w-5
            bg-white
            sm:w-7
          "
        ></span>

        <span
          class="
            block
            h-px
            w-5
            bg-white
            sm:w-7
          "
        ></span>

      </div>

    </button>

  </div>

</header>


<style>

#desktop-nav,
#mobile-nav{

  transition:
    opacity .7s ease,
    transform .7s ease;

}


.header-hidden{

  opacity:0;

  pointer-events:none;

  transform:translateX(40px);

}



.mobile-link{

  position:relative;

  display:flex;

  align-items:center;
  justify-content:center;

  min-width:58px;

  padding:
    4px
    5px
    6px;

  white-space:nowrap;

  font-size:12px;

  letter-spacing:.08em;

  line-height:1;

  transition:
    color .3s ease,
    opacity .3s ease;

}


.mobile-link::after{

  content:"";

  position:absolute;

  left:50%;
  bottom:0;

  width:34px;
  height:5px;

  background:
    url("/images/header-ornament.svg")
    center/contain
    no-repeat;

  opacity:0;

  transform:
    translateX(-50%)
    translateY(3px);

  transition:
    opacity .3s ease,
    transform .3s ease;

  pointer-events:none;

}


.mobile-link:hover,
.mobile-link:focus-visible,
.mobile-link:active{

  color:#f8dfc1;

}


.mobile-link:hover::after,
.mobile-link:focus-visible::after,
.mobile-link:active::after{

  opacity:1;

  transform:
    translateX(-50%)
    translateY(0);

}


.header-link{

  position:relative;

  display:inline-flex;

  justify-content:center;

  padding-bottom:12px;

}


/* 和風文様 */

.header-link::after{

  content:"";

  position:absolute;

  left:50%;
  bottom:-28px;

  width:90px;
  height:80px;

  transform:
    translateX(-50%)
    translateY(4px);

  opacity:0;

  background:
    url("/images/header-ornament.png")
    center/contain
    no-repeat;

  transition:
    opacity .35s ease,
    transform .35s ease;

  pointer-events:none;

}


/* PC Hover */

.header-link:hover::after,
.header-link:focus-visible::after{

  opacity:1;

  transform:
    translateX(-50%)
    translateY(0);

}


/* タップ時 */

.header-link:active::after{

  opacity:1;

  transform:
    translateX(-50%)
    translateY(0);

}


@media(max-width:639px){

  #site-header > div{

    gap:10px;

    min-height:72px;

    padding-top:12px;
    padding-bottom:12px;

  }


  #header-logo img{

    height:38px;

  }


  #mobile-nav{

    flex:
      0
      1
      auto;

    width:auto;

    gap:
      2px
      7px;

  }


  .mobile-link{

    font-size:12px;

  }


  #menu-toggle{

    margin-left:2px;

    width:34px;
    height:34px;

  }


  #menu-toggle span{

    width:19px;

  }

}



@media(max-width:380px)

  #site-header > div{

    gap:6px;

    padding-left:10px;
    padding-right:10px;

  }


  #header-logo img{

    height:34px;

  }


  #mobile-nav{

    gap:
      1px
      4px;

  }


  .mobile-link{

    min-width:52px;

    padding:
      4px
      2px
      5px;

    font-size:11px;

    letter-spacing:.06em;

  }


  #menu-toggle{

    width:31px;
    height:31px;

  }


  #menu-toggle span{

    width:18px;

  }

</style>


<script is:inline>

function initHeader(){

  const header =
    document.getElementById("site-header");


  const desktop =
    document.getElementById("desktop-nav");


  const mobile =
    document.getElementById("mobile-nav");


  const toggle =
    document.getElementById("menu-toggle");


  if(
    !header ||
    !desktop ||
    !mobile ||
    !toggle
  ) return;


  if(toggle.dataset.ready)
    return;


  toggle.dataset.ready="true";


  let menuOpen=false;


  toggle.addEventListener(
    "click",
    ()=>{

      menuOpen=!menuOpen;


      if(menuOpen){

        desktop.classList.add(
          "header-hidden"
        );


        mobile.classList.add(
          "header-hidden"
        );


      }else{

        desktop.classList.remove(
          "header-hidden"
        );


        mobile.classList.remove(
          "header-hidden"
        );

      }

    }
  );


  const scrollHandler=()=>{

    if(window.scrollY>40){

      header.classList.add(
        "bg-[#201710]/35",
        "backdrop-blur-xl",
        "shadow-lg"
      );

    }else{

      header.classList.remove(
        "bg-[#201710]/35",
        "backdrop-blur-xl",
        "shadow-lg"
      );

    }

  };


  scrollHandler();


  window.addEventListener(
    "scroll",
    scrollHandler,
    {
      passive:true
    }
  );

}


initHeader();


document.addEventListener(
  "astro:page-load",
  initHeader
);

</script>
