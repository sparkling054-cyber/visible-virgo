---
// src/components/home/Hero.ko.astro
---

<section
  id="hero"
>


  <div class="relative min-h-screen overflow-hidden">

    <picture>

      <!-- Smartphone -->
      <source
        media="(max-width: 639px)"
        srcset="/images/d34f0156-a65c-4b9b-be23-56dadb9955f3.png"
      />

      <!-- PC / Tablet -->
      <img
        src="/images/78adb63e-2db7-4749-bef0-f032743afcde3.png"
        alt="錦乃"
        class="hero-bg absolute inset-0 h-full w-full object-cover select-none pointer-events-none"
        draggable="false"
      />

    </picture>


    <!-- Mobile -->
    <img
      src="/images/d34f0156-a65c-4b9b-be23-56dadb9955f3.png"
      alt="錦乃"
      class="hero-mobile absolute inset-0 hidden h-full w-full object-cover select-none pointer-events-none"
      draggable="false"
    />

    <!-- Home専用・縦書きロゴ -->
    <img
      src="/images/home-logo-vertical.png"
      alt="錦乃"
      class="
        hero-vertical-logo
        absolute
        left-4
        top-1/4
        z-[5]
        w-20
        -translate-y-1/2
        select-none
        pointer-events-none
        sm:left-8
        sm:w-14
        lg:left-12
        lg:w-36
        w-28
      "
      draggable="false"
    />

    <!-- Overlay -->
    <div class="absolute inset-0 bg-black/5"></div>


    <!-- Hero Content -->

    <div
      class="
        absolute
        inset-x-0
        bottom-0
        z-10
        mx-auto
        flex
        max-w-7xl
        items-end
        justify-between
        px-6
        pb-28
        sm:px-10
        lg:px-12
        lg:pb-24
      "
    >

    </div>


    <!-- Scroll -->

    <div
      class="
        absolute
        bottom-16
        right-6
        z-20
        hidden
        flex-col
        items-center
        sm:right-12
        sm:flex
      "
    >

      <div class="h-20 w-px bg-white/70"></div>

      <span
        class="
          mt-4
          text-xs
          tracking-[0.45em]
          text-white
        "
      >
        SCROLL
      </span>

    </div>

  </div>


  <div class="section-divider" aria-hidden="true"></div>


<section
  id="about"
  class="
    relative
    overflow-hidden
    py-8
    sm:py-10
    lg:py-12
  "
>

  <!-- Background -->

  <img
    src="/images/washi-bg1.png"
    alt=""
    class="
      absolute
      inset-0
      h-full
      w-full
      object-cover
      pointer-events-none
      select-none
    "
    draggable="false"
  />

  <div
    class="
      absolute
      inset-0
      bg-white/35
    "
  ></div>


  <div
    class="
      relative
      mx-auto
      max-w-7xl
      px-3
      sm:px-5
      lg:px-6
    "
  >


<div class="text-left">

  <p
    class="
      text-[8px]
      tracking-[0.3em]
      text-white/80
      uppercase
    "
  >
    ABOUT THIS SITE
  </p>

  <h2
    class="
      mt-2
      text-xl
      leading-tight
      text-white
      sm:text-2xl
      lg:text-3xl
    "
    style="font-family:'Shippori Mincho',serif;"
  >
    이 사이트에 대하여
  </h2>

  <div
    class="
      mt-3
      h-px
      w-16
      bg-gradient-to-r
      from-rose-300
      via-amber-300
      to-sky-300
    "
  ></div>

</div>


<div
  class="
    mt-6
    grid
    gap-3
    lg:grid-cols-[1.15fr_.85fr]
    sm:gap-4
  "
>

  <!-- Overview -->

  <article
    class="
      rounded-[1rem]
      border
      border-white/70
      bg-white/75
      p-4
      shadow-md
      backdrop-blur-xl
      sm:rounded-[1.25rem]
      sm:p-5
    "
  >

    <p
      class="
        text-[8px]
        tracking-[0.25em]
        text-neutral-500
        uppercase
      "
    >
      OVERVIEW
    </p>

    <h3
      class="
        mt-2
        text-base
        text-neutral-900
        sm:text-lg
      "
      style="font-family:'Shippori Mincho',serif;"
    >
      이 사이트에 대하여
    </h3>

    <div
      class="
        mt-3
        h-px
        w-16
        bg-gradient-to-r
        from-rose-300
        via-amber-300
        to-sky-300
      "
    ></div>

    <p
      class="
        mt-3
        text-xs
        leading-6
        text-neutral-700
        sm:text-sm
        sm:leading-7
      "
      style="font-family:'Shippori Mincho',serif;"
    >
      이 사이트는 인플루언서이자 크리에이터인 「錦乃」의 활동과 작품을 소개하는 공식 웹사이트입니다.<br>
      게임과 디지털 공간에서 제작한 일본의 성곽과 역사적 건축물을 중심으로, 다양한 창작 및 콘텐츠 활동을 소개합니다.
    </p>

    <p
      class="
        mt-3
        text-xs
        leading-6
        text-neutral-700
        sm:text-sm
        sm:leading-7
      "
      style="font-family:'Shippori Mincho',serif;"
    >
      작품 소개뿐만 아니라 프로필과 제작 배경, 자료 조사, 영상・SNS 활동,
      지금까지의 성과, 의뢰・협업에 관한 정보 등
      저의 창작 활동 전반을 한곳에 모아 소개하고 있습니다.
    </p>

  </article>

</div>

</div>

</section>

<div class="section-divider" aria-hidden="true"></div>


