    class="
      absolute
      inset-0
      h-full
      w-full
      object-cover
      pointer-events-none
      select-none
    "
    draggable="false"
  />

  <div
    class="
      absolute
      inset-0
      bg-white/35
    "
  ></div>


  <div
    class="
      relative
      mx-auto
      max-w-7xl
      px-3
      sm:px-5
      lg:px-6
    "
