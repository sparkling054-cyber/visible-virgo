---
// src/components/home/Hero.en.astro
---

<section
  id="hero"
>


  <div class="relative min-h-screen overflow-hidden">

    <picture>

      <!-- Smartphone -->
      <source
        media="(max-width: 639px)"
        srcset="/images/d34f0156-a65c-4b9b-be23-56dadb9955f3.png"
      />

      <!-- PC / Tablet -->
      <img
        src="/images/78adb63e-2db7-4749-bef0-f032743afcde3.png"
        alt="Nishikino"
        class="hero-bg absolute inset-0 h-full w-full object-cover select-none pointer-events-none"
        draggable="false"
      />

    </picture>


    <!-- Mobile -->
    <img
      src="/images/d34f0156-a65c-4b9b-be23-56dadb9955f3.png"
      alt="Nishikino"
      class="hero-mobile absolute inset-0 hidden h-full w-full object-cover select-none pointer-events-none"
      draggable="false"
    />

    <!-- Home専用・縦書きロゴ -->
    <img
      src="/images/home-logo-vertical.png"
      alt="Nishikino"
      class="
        hero-vertical-logo
        absolute
        left-4
        top-1/4
        z-[5]
        w-20
        -translate-y-1/2
        select-none
        pointer-events-none
        sm:left-8
        sm:w-14
        lg:left-12
        lg:w-36
        w-28
      "
      draggable="false"
    />

    <!-- Overlay -->
    <div class="absolute inset-0 bg-black/5"></div>


    <!-- Hero Content -->

    <div
      class="
        absolute
        inset-x-0
        bottom-0
        z-10
        mx-auto
        flex
        max-w-7xl
        items-end
        justify-between
        px-6
        pb-28
        sm:px-10
        lg:px-12
        lg:pb-24
      "
    >

    </div>


    <!-- Scroll -->

    <div
      class="
        absolute
        bottom-16
        right-6
        z-20
        hidden
        flex-col
        items-center
        sm:right-12
        sm:flex
      "
    >

      <div class="h-20 w-px bg-white/70"></div>

      <span
        class="
          mt-4
          text-xs
          tracking-[0.45em]
          text-white
        "
      >
        SCROLL
      </span>

    </div>

  </div>


  <div class="section-divider" aria-hidden="true"></div>


<section
