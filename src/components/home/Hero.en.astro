    <h3
      class="
        mt-2
        text-base
        text-neutral-900
        sm:text-lg
      "
      style="font-family:'Shippori Mincho',serif;"
    >
      About This Site
    </h3>

    <div
      class="
        mt-3
        h-px
        w-16
        bg-gradient-to-r
        from-rose-300
        via-amber-300
        to-sky-300
