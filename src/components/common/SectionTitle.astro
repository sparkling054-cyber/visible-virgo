---
interface Props {
  en: string;
  title: string;
  description?: string;
  light?: boolean;
}

const {
  en,
  title,
  description,
  light = false,
} = Astro.props;
---

<div class="text-center">

  <!-- 英字タイトルは常に赤 -->
  <p class="text-sm tracking-[0.4em] text-rose-400 uppercase">
    {en}
  </p>


  <!-- 日本語タイトル -->
  <h2
    class:list={[
      "mt-4 text-2xl md:text-5xl font-bold",
      light ? "text-white" : "text-slate-900"
    ]}
  >
    {title}
  </h2>


  <!-- 説明文 -->
  {
    description && (
      <p
        class:list={[
          "mt-6 text-base md:text-lg",
          light ? "text-white/80" : "text-slate-600"
        ]}
      >
        {description}
      </p>
    )
  }

</div>