---
import Layout from "../../layouts/Layout.astro";

const categories = [
  {
    title: "個人",
    subtitle: "Creator",
    text:
      "YouTube・SNS・配信活動などをされているクリエイター様との交流やコラボレーション。動画や配信での共演、Minecraftを通じた活動、SNSでのコラボレーションなど、ジャンルを問わずさまざまな形で一緒に活動できればと思っています。"
  },
  {
    title: "企業",
    subtitle: "Business",
    text:
       "広告・SNS・映像・イベント・プロモーション・コンテンツ制作など、企業様が取り組まれているさまざまな活動に、出演・コラボレーション・制作協力などの形で携わります。歴史や日本文化に関する企画に限らず、ゲーム・エンターテインメント・旅行・ライフスタイルなど、幅広い分野において、企画の目的や内容に合わせたコンテンツづくりをご一緒できます。すでに具体的な企画がある場合はもちろん、新たな取り組みを検討されている段階から、内容に応じてご一緒することが可能です。"
  },
  {
    title: "自治体・文化機関",
    subtitle: "Public",
    text:
      "観光・文化財維持と継承・歴史イベント・地域活性化など、日本の伝統文化や建造物の魅力を未来へつなぐ取り組みをはじめ、デジタルコンテンツを使用した文化発信や教育分野での活用についてもご相談いただけます。"
  },
  {
    title: "監修・資料提供",
    subtitle: "Research",
    text:
      "城郭・御殿・歴史建築を中心とした資料調査・考証・監修を行っています。番組・映像・ゲーム・展示などにおける歴史建築の表現についても、資料提供や制作協力が可能です。"
  }
];
