            </div>


            <div>
              <p class="text-base text-[#8c8378]">Category</p>
              <p class="text-base">Japanese Castle / Castle Main Tower</p>
            </div>


            <div>
              <p class="text-base text-[#8c8378]">Construction Period</p>
              <p class="text-base">Early Showa Period (1931)</p>
            </div>


            <div>
              <p class="text-base text-[#8c8378]">Location</p>
              <p class="text-base">
                1-1 Osaka Castle, Chuo Ward,<br>
                Osaka City, Osaka 540-0002, Japan
              </p>
            </div>


            <div>
              <p class="text-base text-[#8c8378]">Original Construction</p>
              <p class="text-base">1620</p>
            </div>


            <div>
              <p class="text-base text-[#8c8378]">Builder</p>
              <p class="text-base">Tokugawa Hidetada</p>
            </div>


            <div>
              <p class="text-base text-[#8c8378]">Main Tower Type</p>
              <p class="text-base">
                Third: Independent, watchtower-style Main Tower / Tokugawa period: Independent, layered-tower-style Main Tower
              </p>
            </div>


            <div>
              <p class="text-base text-[#8c8378]">Software</p>
              <p class="text-base">Minecraft Java Edition 1.21.5</p>
            </div>


            <div>
              <p class="text-base text-[#8c8378]">Project Type</p>
              <p class="text-base">Reconstruction / Recreation of Japanese Architecture</p>
            </div>


            <div>
              <p class="text-base text-[#8c8378]">Status</p>
              <p class="text-base">Completed</p>
            </div>

          </div>

        </div>

      </aside>

    </div>



    <div class="mx-auto mt-32 max-w-6xl">

      <div class="flex items-center gap-5">

        <span class="h-px w-20 bg-[#caa14d]"></span>

        <p
          class="text-base tracking-[0.45em] text-[#a58c65]"
          style="font-family:'Cormorant Garamond',serif;"
        >
          GALLERY
        </p>

      </div>


      <h2
        class="mt-6 text-4xl"
        style="font-family:'Shippori Mincho',serif;"
      >
        Gallery
      </h2>


      <div class="gallery mt-12">

        <div class="gallery-frame">

          <img
            src="/images/osaka3-1.png"
            alt="Showa-era reconstructed Main Tower"
          />

        </div>


        <div class="gallery-frame">

          <img
            src="/images/osaka3-2.png"
            alt="Close-up of Osaka Castle Main Tower"
          />

        </div>


        <div class="gallery-frame">

          <img
            src="/images/osaka3-3.png"
            alt="Osaka Castle Main Tower foundation"
          />

        </div>


        <div class="gallery-frame">

          <img
            src="/images/osaka3-4.png"
