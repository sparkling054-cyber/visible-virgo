        rel="noopener noreferrer"
        class="inline-flex rounded-full border border-[#d7c8b3] bg-white px-8 py-4 text-base transition hover:bg-[#2b2724] hover:text-white"
      >
        See More →
      </a>


      <a
        href="https://www.youtube.com/shorts/BrqQReL0fTw"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex rounded-full border border-[#d7c8b3] bg-white px-8 py-4 text-base transition hover:bg-[#2b2724] hover:text-white"
      >
        Watch More Videos →
      </a>



            <div class="mt-32 text-center w-full">

        <div class="flex items-center justify-center gap-5">

          <span class="h-px w-16 bg-[#caa14d]"></span>

          <p
            class="text-base tracking-[0.45em] text-[#a58c65]"
            style="font-family:'Cormorant Garamond',serif;"
          >
            SHARE
          </p>

          <span class="h-px w-16 bg-[#caa14d]"></span>

        </div>


        <h2
          class="mt-6 text-3xl text-[#2b2724]"
          style="font-family:'Shippori Mincho',serif;"
        >
          Share This Work
        </h2>


        <div class="mt-8 flex justify-center gap-4 flex-wrap">

          <!-- X -->

          <a
            href="#"
            id="x-share"
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-full border border-[#d7c8b3] bg-white px-7 py-3 text-base hover:bg-[#2b2724] hover:text-white"
          >
            X
          </a>


          <!-- Instagram -->

          <button
            type="button"
            id="instagram-share"
            class="rounded-full border border-[#d7c8b3] bg-white px-7 py-3 text-base hover:bg-[#2b2724] hover:text-white"
          >
            Instagram
          </button>


          <!-- Copy -->

          <button
            type="button"
            id="copy-url"
            class="rounded-full border border-[#d7c8b3] bg-white px-7 py-3 text-base hover:bg-[#2b2724] hover:text-white"
          >
            Copy URL
          </button>

        </div>

      </div>

    </div>

  </Container>

</section>


<script>

  const sharePhrases = [
    "Found this.",
    "I kind of like this.",
    "Look at this.",
    "Found something interesting.",
    "Found something like this.",
    "Have you seen this?",
    "Found something.",
    "Came across this.",
    "Found something worth checking out."
  ];


  const randomPhrase =
    sharePhrases[
      Math.floor(Math.random() * sharePhrases.length)
    ];


  const pageUrl =
    "https://www.nishikinolab.net/en/osakacastle3/";


  const shareText =
    `${randomPhrase} Minecraft OSAKA CASTLE | WORKS`;


  const xShare =
    document.getElementById("x-share");


  xShare?.setAttribute(
    "href",
    `https://x.com/intent/post?text=${encodeURIComponent(shareText)}&url=${encodeURIComponent(pageUrl)}`
  );


  const copyButton =
    document.getElementById("copy-url");


  const instagramButton =
    document.getElementById("instagram-share");



  copyButton?.addEventListener("click", async () => {

    try {

      await navigator.clipboard.writeText(pageUrl);

      if (copyButton) {

        copyButton.textContent = "Copied";

        setTimeout(() => {

          copyButton.textContent = "Copy URL";

        }, 2000);

      }

    } catch (error) {

      console.error(error);

    }

  });


  instagramButton?.addEventListener("click", () => {

    const dialog =
      document.createElement("div");


    dialog.innerHTML = `

      <div
        id="instagram-share-overlay"
        style="
          position:fixed;
          inset:0;
          z-index:9999;
          display:flex;
          align-items:center;
          justify-content:center;
          padding:24px;
          background:rgba(43,39,36,.55);
          backdrop-filter:blur(6px);
        "
      >

        <div
          style="
            width:100%;
            max-width:420px;
            padding:36px;
            border:1px solid #e2d8cb;
            border-radius:28px;
            background:#fffdfa;
            box-shadow:0 20px 60px rgba(0,0,0,.18);
            text-align:center;
          "
        >

          <p
            style="
              margin:0;
              font-family:'Cormorant Garamond',serif;
              font-size:14px;
              letter-spacing:.35em;
              color:#a58c65;
            "
          >
            SHARE
          </p>


          <h3
            style="
              margin:14px 0 0;
              font-family:'Shippori Mincho',serif;
              font-size:24px;
              color:#2b2724;
              font-weight:400;
            "
          >
            Share on Instagram
          </h3>


          <p
            style="
              margin:20px 0 0;
              font-family:'Shippori Mincho',serif;
              font-size:14px;
              line-height:2;
              color:#625a52;
            "
          >
            Copy the URL of this work page<br>
            and open Instagram.
          </p>


          <button
            id="instagram-open"
            type="button"
            style="
              width:100%;
              margin-top:28px;
              padding:14px 20px;
              border:1px solid #d7c8b3;
              border-radius:999px;
              background:#2b2724;
              color:#fff;
              font-family:'Shippori Mincho',serif;
              font-size:15px;
              cursor:pointer;
            "
          >
            Copy URL and Open Instagram
          </button>


          <button
            id="instagram-cancel"
            type="button"
            style="
              width:100%;
              margin-top:10px;
              padding:12px 20px;
              border:0;
              background:transparent;
              color:#8c8378;
              font-family:'Shippori Mincho',serif;
              font-size:14px;
              cursor:pointer;
            "
          >
            Cancel
          </button>

        </div>

      </div>

    `;


    document.body.appendChild(dialog);


    const overlay =
      document.getElementById(
        "instagram-share-overlay"
      );


    const openButton =
      document.getElementById(
        "instagram-open"
      );


    const cancelButton =
      document.getElementById(
        "instagram-cancel"
      );


    openButton?.addEventListener(
      "click",
      async () => {

        try {

          await navigator.clipboard.writeText(
            pageUrl
          );

        } catch (error) {

          console.error(error);

        }


        window.open(
          "https://www.instagram.com/",
          "_blank",
          "noopener,noreferrer"
        );


        overlay?.remove();

      }
    );


    cancelButton?.addEventListener(
      "click",
      () => {

        overlay?.remove();

      }
    );


    overlay?.addEventListener(
      "click",
      (event) => {

        if (event.target === overlay) {

          overlay.remove();

        }

      }
    );

  });

</script>



<style>

.work-hero {

  animation:
    heroFloat 12s ease-in-out infinite;

  transform-origin:
