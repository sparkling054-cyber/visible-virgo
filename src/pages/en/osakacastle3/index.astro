      rgba(205,175,98,.06),
      transparent 22%
    );

}


aside {

  position:
    sticky;

  top:
    120px;

  height:
    max-content;

}


a {

  transition:
    .35s;

}


.gallery{

display:grid;

grid-template-columns:repeat(2,minmax(0,1fr));

gap:1.5rem;

}


.gallery-frame {

  position:
    relative;

  padding:
    2px;

  border-radius:
    1.25rem;

  background:

    linear-gradient(
      to right,
      transparent 0%,
      rgba(253, 164, 175, 0.65) 25%,
      rgba(252, 211, 77, 0.65) 50%,
      rgba(125, 211, 252, 0.65) 75%,
      transparent 100%
    );

  overflow:
    hidden;

}


.gallery-frame img {

  display:
    block;

  width:
    100%;

  height:
    auto;

  border-radius:
    calc(1.25rem - 2px);

  background:
    #f8f6f2;

}


.gallery-frame:hover {

  background:

    linear-gradient(
      to right,
      transparent 0%,
      rgba(253, 164, 175, 0.9) 25%,
      rgba(252, 211, 77, 0.9) 50%,
      rgba(125, 211, 252, 0.9) 75%,
      transparent 100%
    );

}


@media (max-width:1100px) {

  section {

    overflow:
      hidden;

  }


}


@media (max-width:768px) {

  section:first-child {

    height:
      760px;

  }


  .gallery-frame {

    border-radius:
      1rem;

  }


  .gallery-frame img {

    border-radius:
      calc(1rem - 2px);

  }

}

</style>

</Layout>