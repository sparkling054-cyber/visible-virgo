---
import Layout from "../../../../layouts/Layout.astro";

const categories = [
  {
    title: "Creators",
    subtitle: "Creator",
    text:
      "I welcome opportunities to connect and collaborate with creators involved in YouTube, social media, streaming, and other forms of online activity. Whether through video appearances, streaming, Minecraft projects, or social media collaborations, I am open to creating something together across a wide range of genres."
  },
  {
    title: "Businesses",
    subtitle: "Business",
    text:
      "I can work with companies on a wide range of projects, including advertising, social media, video, events, promotions, and content creation, through appearances, collaborations, and creative support. This is not limited to projects involving history or Japanese culture; I can also work together on content related to games, entertainment, travel, lifestyle, and many other fields, depending on the goals and nature of the project. Whether you already have a specific project in mind or are still considering a new initiative, I am happy to discuss how we might work together."
  },
  {
    title: "Local Governments & Cultural Organizations",
    subtitle: "Public",
    text:
      "I welcome opportunities related to tourism, the preservation and continuation of cultural heritage, historical events, regional revitalization, and other initiatives that connect the appeal of Japanese traditional culture and architecture with the future. I am also available to discuss cultural communication and educational projects using digital content."
  },
  {
    title: "Research & Historical Supervision",
    subtitle: "Research",
    text:
      "I conduct research, historical verification, and supervision primarily focused on castles, palaces, and historic Japanese architecture. I can also provide historical materials and production support for the representation of historic architecture in television programs, video productions, games, exhibitions, and other media."
  }
];
