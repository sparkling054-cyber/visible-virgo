---
import Layout from "../../../layouts/Layout.astro";

const categories = [
  "Individual / Creator",
  "Company / Corporation",
  "Local Government / Cultural Organization",
  "Media / Event",
  "Research / Materials",
  "Other"
];

const purposes = [
  "YouTube / Video Production",
  "SNS / Content Creation",
  "Creator Collaboration",
  "Minecraft / Digital Production",
  "History / Castles / Culture",
  "Supervision / Materials",
  "Media Appearance / Interview",
  "Company / City / Organization / Local Government Project",
  "Other"
];
---

<Layout
  title="Nishikino｜Contact"
  description=""
>

<section
  class="relative h-[650px] overflow-hidden"
>

<img
  src="/images/contact-form-bg.png"
  alt="Contact form background"
  class="form-image absolute inset-0 h-full w-full object-cover select-none"
  draggable="false"
/>

<div
  class="absolute inset-0 bg-black/20"
></div>

<div
  class="relative z-10 flex h-full items-center justify-center px-8 text-center text-white"
>

<div
  class="form-reveal"
>

<p
  class="tracking-[0.45em] text-sm"
>
CONTACT FORM
</p>

<h1
  class="form-title mt-6 text-6xl"
  style="font-family:'Cormorant Garamond',serif;"
>
Inquiries &amp; Consultation
</h1>

<p
  class="mt-8 leading-9"
  style="font-family:'Shippori Mincho',serif;"
>
“Could you do something like this?”<br><br>

Even if it starts with just a simple question,<br>
that is completely fine.<br>

Even if the details are not decided yet,<br>
please feel free to tell me what you have in mind.
</p>

</div>

</div>

</section>

<section
class="bg-[#faf8f3] py-32"
>

<div
class="mx-auto max-w-5xl px-8"
>

<div
class="form-reveal mb-20 text-center"
>

<p
class="tracking-[0.35em] text-sm text-neutral-500"
>
MESSAGE
</p>

<h2
class="form-subtitle mt-5 text-5xl text-neutral-900"
style="font-family:'Cormorant Garamond',serif;"
>
Feel Free to Reach Out.
</h2>

<p
class="mx-auto mt-8 max-w-3xl leading-9 text-neutral-700"
style="font-family:'Shippori Mincho',serif;"
>

Whether it is a production request, project consultation,<br>
or collaboration, I am happy to hear from you,<br>
even when the details are still taking shape.

<br><br>

“Wouldn't it be interesting if we could do something like this?”<br><br>

I would love to explore that idea together and turn it into something real.

</p>

</div>

<form
action="/api/contact"
method="POST"
class="form-card form-reveal rounded-[2.5rem] border border-white bg-white/80 p-10 shadow-xl backdrop-blur-md md:p-14"
>

<div
class="hidden"
aria-hidden="true"
>

<label>
Leave this field empty
</label>

<input
type="text"
name="website"
/>

</div>

<input
type="hidden"
name="locale"
value="en"
/>

<div
class="grid gap-8"
>

<div>

<label
for="category"
class="block text-sm tracking-widest text-neutral-600"
>
About You
</label>

<select
id="category"
name="category"
required
class="form-field mt-4 w-full rounded-2xl border border-neutral-200 bg-white px-5 py-4 text-neutral-800 outline-none transition focus:border-neutral-800"
>

<option value="">
Please select
</option>

{
categories.map((category)=>(
<option value={category}>
{category}
</option>
))
}

</select>

</div>

<div>

<label
for="name"
class="block text-sm tracking-widest text-neutral-600"
>
Name
</label>

<input
id="name"
name="name"
type="text"
required
maxlength="50"
placeholder="Please enter your name or creator name"
class="form-field mt-4 w-full rounded-2xl border border-neutral-200 bg-white px-5 py-4 text-neutral-800 outline-none transition focus:border-neutral-800"
/>

</div>

<div>

<label
for="sns"
class="block text-sm tracking-widest text-neutral-600"
>
SNS / Website (Optional)
</label>

<input
id="sns"
name="sns"
type="url"
placeholder="YouTube, X, website, etc."
class="form-field mt-4 w-full rounded-2xl border border-neutral-200 bg-white px-5 py-4 text-neutral-800 outline-none transition focus:border-neutral-800"
/>

</div>

<div>

<label
for="email"
class="block text-sm tracking-widest text-neutral-600"
>
Email Address
</label>

<input
id="email"
name="email"
type="email"
required
placeholder="example@example.com"
class="form-field mt-4 w-full rounded-2xl border border-neutral-200 bg-white px-5 py-4 text-neutral-800 outline-none transition focus:border-neutral-800"
/>

</div>

<div>

<label
for="organization"
class="block text-sm tracking-widest text-neutral-600"
>
Company / Organization (Optional)
</label>

<input
id="organization"
name="organization"
type="text"
maxlength="100"
placeholder="Please enter your company or organization name"
class="form-field mt-4 w-full rounded-2xl border border-neutral-200 bg-white px-5 py-4 text-neutral-800 outline-none transition focus:border-neutral-800"
/>

</div>

<div>

<label
for="purpose"
class="block text-sm tracking-widest text-neutral-600"
>
Purpose of Inquiry
</label>

<select
id="purpose"
name="purpose"
required
class="form-field mt-4 w-full rounded-2xl border border-neutral-200 bg-white px-5 py-4 text-neutral-800 outline-none transition focus:border-neutral-800"
>

<option value="">
Please select
</option>

{
purposes.map((purpose)=>(
<option value={purpose}>
{purpose}
</option>
))
}

</select>

</div>

<div
id="other-purpose-area"
class="hidden"
>

<label
for="otherPurpose"
class="block text-sm tracking-widest text-neutral-600"
>
Purpose of Inquiry (Free Text)
</label>

<input
id="otherPurpose"
name="otherPurpose"
type="text"
maxlength="200"
placeholder="Please describe your inquiry"
class="form-field mt-4 w-full rounded-2xl border border-neutral-200 bg-white px-5 py-4 text-neutral-800 outline-none transition focus:border-neutral-800"
/>

</div>

<div>

<label
for="message"
class="block text-sm tracking-widest text-neutral-600"
>
Message
</label>

<textarea
id="message"
name="message"
required
maxlength="2000"
rows="8"
placeholder="Please describe your inquiry, what you would like to create, or anything else you would like to discuss.

It is completely fine if the details are not decided yet."
class="form-field mt-4 w-full rounded-2xl border border-neutral-200 bg-white px-5 py-4 leading-8 text-neutral-800 outline-none transition focus:border-neutral-800"
></textarea>

<p
class="mt-3 text-xs text-neutral-500"
>
Maximum 2,000 characters.
</p>

</div>

<div
class="pt-8 text-center"
>

<button
type="submit"
class="form-submit inline-flex h-40 w-40 items-center justify-center rounded-full border border-neutral-900 bg-white text-lg transition duration-500 hover:-translate-y-2 hover:shadow-2xl"
>

Send

</button>

</div>

</div>

</form>

</div>

</section>

<section
class="bg-white py-24"
>

<div
class="mx-auto max-w-5xl px-8 text-center"
>

<div
class="form-reveal"
>

</div>

<a
href="/en/contact/"
class="form-reveal mt-16 inline-flex rounded-full border border-neutral-800 px-10 py-4 transition hover:bg-neutral-900 hover:text-white"
>
Back to CONTACT
</a>

</div>

</section>

<style>

.form-image{

animation:formFloat 12s ease-in-out infinite;
transform-origin:center;

}

@keyframes formFloat{

0%{transform:scale(1.03) translateY(0);}
50%{transform:scale(1.06) translateY(-18px);}
100%{transform:scale(1.03) translateY(0);}

}

.form-reveal{

opacity:0;

transform:translateY(60px) scale(.97);

transition:
opacity .9s cubic-bezier(.22,1,.36,1),
transform .9s cubic-bezier(.22,1,.36,1);

}

.form-show{

animation:formBounce .9s cubic-bezier(.22,1,.36,1) forwards;

}

@keyframes formBounce{

0%{
opacity:0;
transform:translateY(60px) scale(.97);
}

70%{
opacity:1;
transform:translateY(-8px) scale(1.02);
}

100%{
opacity:1;
transform:translateY(0) scale(1);
}

}

.hidden{
display:none;
}


@media (max-width:640px){

.form-title{

font-size:2.1rem;

}

.form-subtitle{

font-size:2.3rem;

}

.form-card{

padding:1.5rem;

border-radius:1.8rem;

}

.form-field{

font-size:.92rem;

padding:.85rem 1rem;

}

.form-submit{

width:7.5rem;
height:7.5rem;
font-size:1rem;

}

}

</style>

<script>

const observer=new IntersectionObserver((entries)=>{

entries.forEach((entry)=>{

if(!entry.isIntersecting)return;

entry.target.classList.add("form-show");

observer.unobserve(entry.target);

});

},{
threshold:0.18
});

document.querySelectorAll(".form-reveal").forEach((element)=>{

observer.observe(element);

});

const purposeSelect=document.getElementById("purpose");
const otherArea=document.getElementById("other-purpose-area");
const otherInput=document.getElementById("otherPurpose");

function toggleOtherPurpose(){

if(
purposeSelect &&
otherArea &&
otherInput &&
purposeSelect.value==="Other"
){

otherArea.classList.remove("hidden");
otherInput.required=true;

}else if(
otherArea &&
otherInput
){

otherArea.classList.add("hidden");
otherInput.required=false;
otherInput.value="";

}

}

toggleOtherPurpose();

if(purposeSelect){

purposeSelect.addEventListener("change",toggleOtherPurpose);

}

</script>

</Layout>