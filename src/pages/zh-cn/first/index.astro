---
import Layout from "../../../layouts/Layout.astro";
import Container from "../../../components/common/Container.astro";
---

<Layout
  title="锦乃｜起点｜作品"
  description=""
>

<!-- Hero -->
<section class="relative h-[920px] overflow-hidden bg-[#f5f1ea]">

  <!-- Background -->
  <img
    src="/images/washi-bg1.png"
    alt=""
    class="work-hero absolute inset-0 h-full w-full object-cover pointer-events-none select-none"
    draggable="false"
  />

  <!-- Dark Overlay -->
  <div class="absolute inset-0 bg-gradient-to-r from-[#f6f1e7]/85 via-[#f6f1e7]/45 to-transparent"></div>

  <!-- Content -->
  <div class="absolute inset-0 z-20 flex items-center">

    <Container>

      <div class="hero-content max-w-3xl">

        <!-- English -->
        <p
          class="mt-10 text-base tracking-[0.45em] text-[#f6e8c8]"
          style="font-family:'Cormorant Garamond',serif;"
        >
          First
        </p>

        <!-- Title -->
        <h1
          class="mt-1 text-[36px] leading-[1.15] text-[#ffffff]"
          style="font-family:'Shippori Mincho',serif;"
        >
          起点
        </h1>

        <!-- Gold Divider -->
        <div class="mt-1">
          <img
            src="/images/gold-divider.png"
            alt=""
            class="w-[420px] h-auto select-none pointer-events-none"
            draggable="false"
          />
        </div>

        <!-- Summary -->
        <div class="mt-14 max-w-2xl">

        </div>

      </div>

    </Container>

  </div>

  <!-- Scroll -->
  <div class="absolute bottom-16 right-12 z-30 flex flex-col items-center">

    <div class="h-20 w-px bg-white/70"></div>

    <span class="mt-4 text-base tracking-[0.45em] text-white">
      SCROLL
    </span>

  </div>

</section>

<!-- Introduction -->
<section class="relative bg-[#f8f6f2] overflow-hidden works-detail">

  <!-- Washi Background -->
  <img
    src="/images/washi-bg.png"
    alt=""
    class="absolute right-0 top-0 h-full w-full opacity-[0.3] pointer-events-none select-none -z-0"
  />

  <Container class="py-32 relative z-10">

    <div class="mx-auto max-w-6xl">

      <div class="flex items-center gap-6">

      </div>

      <span class="h-px w-24 bg-[#caa14d]"></span>

      <!-- Information -->

      <div class="mx-auto mt-24 grid max-w-6xl gap-16 lg:grid-cols-[1fr_360px]">

        <!-- Left -->

        <div>

          <div class="flex items-center gap-5">

            <span class="h-px w-20 bg-[#caa14d]"></span>

            <p
              class="text-base tracking-[0.4em] text-[#9a8358]"
              style="font-family:'Cormorant Garamond',serif;"
            >
              HISTORY
            </p>

          </div>

          <h2
            class="mt-8 text-3xl text-[#2b2724]"
            style="font-family:'Shippori Mincho',serif;"
          >
            最初的记录
          </h2>

          <p
            class="mt-10 text-base leading-10 text-[#4f4944]"
            style="font-family:'Shippori Mincho',serif;"
          >
            2012年2月26日，这是我第一次玩我的世界那一天的记录。<br>
            当时用DSiLL拍摄的视频和照片，后来在修好的iPhone 4s中勉强保存了下来。<br>
            小时候我很喜欢和朋友一起到处寻找Flash小游戏。那时正在寻找新的游戏，于是遇见了我的世界。<br>
            我最初接触到的是面向PC Gamer读者免费提供的
            「Minecraft PC Gamer Demo」。<br>
            这是2011年6月发布的体验版，而我开始玩的时候，距离它发布还只有大约8个月。版本为Beta 1.3。<br><br>

            后来，我又开始接触手机版的「Minecraft Pocket Edition」0.2.1。<br>
            期间虽然有过一段段间隔，但我还是持续玩了好几年，一直到Version 0.17.0，都在手机上体验着我的世界。

            <br><br>

            在这期间，我也接触过Java版，Version 1.2、1.5.2、1.7.10等版本的大型更新，也都在当时亲身体验过。

            2020年夏天开始，我将世界存档迁移到了Java版，此后从2024年开始在Java版上进行建筑创作。

            <br><br>

            这是一个小时候因为兴趣而接触到的游戏，我从来没有想过，它竟然会在十几年后的我的人生中产生如此大的影响。如果把现在的自己告诉小时候的自己，大概会让那个时候的我大吃一惊吧……

          </p>

        </div>

        <!-- DATA -->

        <aside class="relative">

          <div
            class="rounded-[2rem] border border-[#e2d8cb] bg-[#fffdfa] p-10 shadow-[0_20px_60px_rgba(0,0,0,.07)]"
          >

            <p
              class="text-base tracking-[0.4em] text-[#a68b64]"
              style="font-family:'Cormorant Garamond',serif;"
            >
              DATA
            </p>

            <div class="mt-10 space-y-8">

              <div>
                <p class="text-base text-[#8c8378]">记录日期</p>
                <p class="text-base">2012年2月26日</p>
              </div>

              <div>
                <p class="text-base text-[#8c8378]">游戏版本</p>
                <p class="text-base">Minecraft PC Gamer Demo　Beta 1.3</p>
              </div>

              <div>
                <p class="text-base text-[#8c8378]">最初的制作</p>
                <p class="text-base">类似水坝的水道</p>
              </div>

            </div>

          </div>

        </aside>

      </div>

<!-- Gallery -->

<div class="mx-auto mt-32 max-w-6xl">

  <div class="flex items-center gap-5">

    <span class="h-px w-20 bg-[#caa14d]"></span>

    <p
      class="text-base tracking-[0.45em] text-[#a58c65]"
      style="font-family:'Cormorant Garamond',serif;"
    >
      GALLERY
    </p>

  </div>

  <h2
    class="mt-6 text-4xl"
    style="font-family:'Shippori Mincho',serif;"
  >
    展示照片
  </h2>

  <div class="gallery mt-12">

    <div class="gallery-frame">
      <img
        src="/images/11.png"
        alt=""
      />
    </div>

    <div class="gallery-frame">
      <img
        src="/images/12.jpg"
        alt=""
      />
    </div>

    <div class="gallery-frame">
      <img
        src="/images/13.png"
        alt=""
      />
    </div>

  </div>

</div>

    </div>

    <!-- Back -->

    <div class="mt-24">

      <a
        href="/zh-cn/works/"
        class="inline-flex rounded-full border border-[#d7c8b3] bg-white px-8 py-4 text-base transition hover:bg-[#2b2724] hover:text-white"
      >
        ← 返回
      </a>

      <a
        href="/zh-cn/nishikinoedocastle1/"
        class="inline-flex rounded-full border border-[#d7c8b3] bg-white px-8 py-4 text-base transition hover:bg-[#2b2724] hover:text-white"
      >
        最早的作品 →
      </a>

<!-- Share -->

      <div class="mt-32 text-center">

        <div class="flex items-center justify-center gap-5">

          <span class="h-px w-16 bg-[#caa14d]"></span>

          <p
            class="text-base tracking-[0.45em] text-[#a58c65]"
            style="font-family:'Cormorant Garamond',serif;"
          >
            SHARE
          </p>

          <span class="h-px w-16 bg-[#caa14d]"></span>

        </div>

        <h2
          class="mt-6 text-3xl text-[#2b2724]"
          style="font-family:'Shippori Mincho',serif;"
        >
          分享作品
        </h2>

        <div class="mt-8 flex justify-center gap-4 flex-wrap">

          <a
            href="#"
            id="x-share"
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-full border border-[#d7c8b3] bg-white px-7 py-3 text-base hover:bg-[#2b2724] hover:text-white"
          >
            X
          </a>

          <button
            type="button"
            id="instagram-share"
            class="rounded-full border border-[#d7c8b3] bg-white px-7 py-3 text-base hover:bg-[#2b2724] hover:text-white"
          >
            Instagram
          </button>

          <button
            type="button"
            id="copy-url"
            class="rounded-full border border-[#d7c8b3] bg-white px-7 py-3 text-base hover:bg-[#2b2724] hover:text-white"
          >
            复制URL
          </button>

        </div>

      </div>

    </div>

  </Container>

</section>

<script>
  const pageUrl = "https://www.nishikinolab.net/zh-cn/first/";

  const sharePhrases = [
    "找到这个了。",
    "这个莫名有点喜欢。",
    "看看这个。",
    "发现了个挺让人在意的东西。",
    "发现了这个。",
    "你知道这个吗？",
    "发现了个东西。",
    "原来还有这个。",
    "发现了个有点在意的东西。"
  ];

  const randomPhrase =
    sharePhrases[Math.floor(Math.random() * sharePhrases.length)];

  const shareText = `${randomPhrase} Minecraft 起点 | WORKS`;

  const xShareButton = document.getElementById("x-share");
  const copyButton = document.getElementById("copy-url");
  const instagramButton = document.getElementById("instagram-share");

  xShareButton?.setAttribute(
    "href",
    `https://x.com/intent/post?text=${encodeURIComponent(shareText)}&url=${encodeURIComponent(pageUrl)}`
  );

  copyButton?.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(pageUrl);

      if (copyButton) {
        copyButton.textContent = "已复制";

        setTimeout(() => {
          copyButton.textContent = "复制URL";
        }, 2000);
      }
    } catch (error) {
      console.error(error);
    }
  });

  instagramButton?.addEventListener("click", () => {

    const dialog = document.createElement("div");

    dialog.innerHTML = `
      <div
        id="instagram-share-overlay"
        style="
          position:fixed;
          inset:0;
          z-index:9999;
          display:flex;
          align-items:center;
          justify-content:center;
          padding:24px;
          background:rgba(43,39,36,.55);
          backdrop-filter:blur(6px);
        "
      >
        <div
          style="
            width:100%;
            max-width:420px;
            padding:36px;
            border:1px solid #e2d8cb;
            border-radius:28px;
            background:#fffdfa;
            box-shadow:0 20px 60px rgba(0,0,0,.18);
            text-align:center;
          "
        >

          <p
            style="
              margin:0;
              font-family:'Cormorant Garamond',serif;
              font-size:14px;
              letter-spacing:.35em;
              color:#a58c65;
            "
          >
            SHARE
          </p>

          <h3
            style="
              margin:14px 0 0;
              font-family:'Shippori Mincho',serif;
              font-size:24px;
              color:#2b2724;
              font-weight:400;
            "
          >
            在Instagram上分享
          </h3>

          <p
            style="
              margin:20px 0 0;
              font-family:'Shippori Mincho',serif;
              font-size:14px;
              line-height:2;
              color:#625a52;
            "
          >
            复制此作品页面的URL后<br>
            打开Instagram。
          </p>

          <button
            id="instagram-open"
            type="button"
            style="
              width:100%;
              margin-top:28px;
              padding:14px 20px;
              border:1px solid #d7c8b3;
              border-radius:999px;
              background:#2b2724;
              color:#fff;
              font-family:'Shippori Mincho',serif;
              font-size:15px;
              cursor:pointer;
            "
          >
            复制URL并打开Instagram
          </button>

          <button
            id="instagram-cancel"
            type="button"
            style="
              width:100%;
              margin-top:10px;
              padding:12px 20px;
              border:0;
              background:transparent;
              color:#8c8378;
              font-family:'Shippori Mincho',serif;
              font-size:14px;
              cursor:pointer;
            "
          >
            取消
          </button>

        </div>
      </div>
    `;

    document.body.appendChild(dialog);

    const overlay = document.getElementById("instagram-share-overlay");
    const openButton = document.getElementById("instagram-open");
    const cancelButton = document.getElementById("instagram-cancel");

    openButton?.addEventListener("click", async () => {

      try {
        await navigator.clipboard.writeText(pageUrl);
      } catch (error) {
        console.error(error);
      }

      window.open(
        "https://www.instagram.com/",
        "_blank",
        "noopener,noreferrer"
      );

      overlay?.remove();
    });

    cancelButton?.addEventListener("click", () => {
      overlay?.remove();
    });

    overlay?.addEventListener("click", (event) => {
      if (event.target === overlay) {
        overlay.remove();
      }
    });
  });
</script>

<style>

.work-hero{
  animation:heroFloat 12s ease-in-out infinite;
  transform-origin:center;
}

@keyframes heroFloat{

0%{
transform:scale(1.03) translateY(0);
}

50%{
transform:scale(1.06) translateY(-18px);
}

100%{
transform:scale(1.03) translateY(0);
}

}

section{
position:relative;
}

section::before{
content:"";
position:absolute;
left:0;
top:0;
width:100%;
height:100%;
pointer-events:none;
background-image:
radial-gradient(circle at 8% 10%,rgba(205,175,98,.08),transparent 18%),
radial-gradient(circle at 92% 82%,rgba(205,175,98,.06),transparent 22%);
}

aside{
position:sticky;
top:120px;
height:max-content;
}

a{
transition:.35s;
}

@media(max-width:1100px){

section{
overflow:hidden;
}

}

@media(max-width:900px){

aside{
position:relative;
top:auto;
}

}

@media(max-width:768px){

section:first-child{
height:760px;
}

h1{
font-size:44px !important;
line-height:1.15;
}

h2{
font-size:32px !important;
}

.work-hero{
animation:none;
}

}


.gallery-frame {
  position: relative;
  padding: 2px;
  border-radius: 1.25rem;

  background:
    linear-gradient(
      to right,
      transparent 0%,
      rgba(253, 164, 175, 0.65) 25%,
      rgba(252, 211, 77, 0.65) 50%,
      rgba(125, 211, 252, 0.65) 75%,
      transparent 100%
    );

  overflow: hidden;
}

.gallery-frame img {
  display: block;
  width: 100%;
  height: auto;

  border-radius: calc(1.25rem - 2px);

  background: #f8f6f2;
}

.gallery-frame:hover {
  background:
    linear-gradient(
      to right,
      transparent 0%,
      rgba(253, 164, 175, 0.9) 25%,
      rgba(252, 211, 77, 0.9) 50%,
      rgba(125, 211, 252, 0.9) 75%,
      transparent 100%
    );
}

</style>

</Layout>
