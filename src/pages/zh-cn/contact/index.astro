---
import Layout from "../../../layouts/Layout.astro";

const categories = [
  {
    title: "个人",
    subtitle: "Creator",
    text:
      "与从事YouTube、社交媒体、直播等活动的创作者进行交流与合作。无论是视频或直播中的共同出演、通过我的世界展开合作，还是社交媒体上的联动，我都希望能够以各种形式与不同领域的创作者一起开展活动。"
  },
  {
    title: "企业",
    subtitle: "Business",
    text:
      "无论是广告、社交媒体、影像、活动、宣传推广还是内容制作等企业项目，我都可以通过出演、合作、制作协力等形式参与其中。不仅限于历史与日本文化相关的企划，在游戏、娱乐、旅行、生活方式等广泛领域，也可以根据企划的目的与内容，一起制作合适的内容。无论是已经有具体企划，还是仍处于考虑开展新项目的阶段，都可以根据具体情况进行合作。"
  },
  {
    title: "地方政府・文化机构",
    subtitle: "Public",
    text:
      "除了旅游、文化遗产保护与传承、历史活动、地方振兴等将日本传统文化与建筑之美传承至未来的项目之外，也欢迎就利用数字内容进行文化传播，以及教育领域中的应用等方面进行咨询。"
  },
  {
    title: "考证・资料提供",
    subtitle: "Research",
    text:
      "主要围绕城郭、御殿及历史建筑进行资料调查、历史考证与监修。对于节目、影像、游戏、展览等内容中的历史建筑表现，也可以提供相关资料并协助制作。"
  }
];
