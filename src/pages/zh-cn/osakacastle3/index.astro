              <p class="text-base">我的世界 Java Edition 1.21.5</p>
            </div>


            <div>
              <p class="text-base text-[#8c8378]">作品类型</p>
              <p class="text-base">日式建筑复原・再现</p>
            </div>


            <div>
              <p class="text-base text-[#8c8378]">制作状态</p>
              <p class="text-base">完成</p>
            </div>

          </div>

        </div>

      </aside>

    </div>



    <div class="mx-auto mt-32 max-w-6xl">

      <div class="flex items-center gap-5">

        <span class="h-px w-20 bg-[#caa14d]"></span>

        <p
          class="text-base tracking-[0.45em] text-[#a58c65]"
          style="font-family:'Cormorant Garamond',serif;"
        >
          GALLERY
        </p>

      </div>


      <h2
        class="mt-6 text-4xl"
        style="font-family:'Shippori Mincho',serif;"
      >
        展示照片
      </h2>


      <div class="gallery mt-12">

        <div class="gallery-frame">

          <img
            src="/images/osaka3-1.png"
            alt="昭和时期复兴天守阁"
          />

        </div>


        <div class="gallery-frame">

          <img
            src="/images/osaka3-2.png"
            alt="大阪城天守特写"
          />

        </div>


        <div class="gallery-frame">

          <img
            src="/images/osaka3-3.png"
            alt="大阪城天守台"
          />

        </div>


        <div class="gallery-frame">

          <img
            src="/images/osaka3-4.png"
            alt="第三代大阪城天守实景"
          />

        </div>

      </div>

    </div>



    <div class="mt-24 flex flex-wrap gap-4">

      <a
        href="/zh-cn/works/"
        class="inline-flex rounded-full border border-[#d7c8b3] bg-white px-8 py-4 text-base transition hover:bg-[#2b2724] hover:text-white"
      >
        ← 返回作品列表
      </a>


      <a
        href="https://x.com/nishikinolab/status/1977305781914767393"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex rounded-full border border-[#d7c8b3] bg-white px-8 py-4 text-base transition hover:bg-[#2b2724] hover:text-white"
      >
        查看更多 →
      </a>


      <a
        href="https://www.youtube.com/shorts/BrqQReL0fTw"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex rounded-full border border-[#d7c8b3] bg-white px-8 py-4 text-base transition hover:bg-[#2b2724] hover:text-white"
      >
        查看更多视频 →
      </a>



              <div class="mt-32 text-center w-full">

        <div class="flex items-center justify-center gap-5">

          <span class="h-px w-16 bg-[#caa14d]"></span>

          <p
            class="text-base tracking-[0.45em] text-[#a58c65]"
            style="font-family:'Cormorant Garamond',serif;"
          >
            SHARE
          </p>

          <span class="h-px w-16 bg-[#caa14d]"></span>

        </div>


        <h2
          class="mt-6 text-3xl text-[#2b2724]"
          style="font-family:'Shippori Mincho',serif;"
        >
          分享作品
        </h2>


        <div class="mt-8 flex justify-center gap-4 flex-wrap">

          <!-- X -->

          <a
            href="#"
            id="x-share"
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-full border border-[#d7c8b3] bg-white px-7 py-3 text-base hover:bg-[#2b2724] hover:text-white"
          >
            X
          </a>


          <!-- Instagram -->

          <button
            type="button"
            id="instagram-share"
            class="rounded-full border border-[#d7c8b3] bg-white px-7 py-3 text-base hover:bg-[#2b2724] hover:text-white"
          >
            Instagram
          </button>


          <!-- Copy -->

          <button
            type="button"
            id="copy-url"
            class="rounded-full border border-[#d7c8b3] bg-white px-7 py-3 text-base hover:bg-[#2b2724] hover:text-white"
          >
            复制URL
          </button>

        </div>

      </div>

    </div>

  </Container>

</section>


<script>

  const pageUrl =
    "https://www.nishikinolab.net/zh-cn/osakacastle3/";


  const sharePhrases = [

    "找到这个了。",
    "这个莫名有点喜欢。",
    "看看这个。",
    "发现了个挺让人在意的东西。",
    "发现了这个。",
    "你知道这个吗？",
    "发现了个东西。",
    "原来还有这个。",
    "发现了个有点在意的东西。"

  ];


  const randomPhrase =
    sharePhrases[
      Math.floor(Math.random() * sharePhrases.length)
    ];


  const shareText =
    `${randomPhrase} Minecraft 大阪城 | WORKS`;


  const xShareButton =
    document.getElementById("x-share");


  if (xShareButton) {

    xShareButton.setAttribute(
      "href",
      `https://x.com/intent/post?text=${encodeURIComponent(shareText)}&url=${encodeURIComponent(pageUrl)}`
    );

  }


  const copyButton =
    document.getElementById("copy-url");


  const instagramButton =
    document.getElementById("instagram-share");



  copyButton?.addEventListener("click", async () => {

    try {

      await navigator.clipboard.writeText(pageUrl);

      if (copyButton) {

        copyButton.textContent = "已复制";

        setTimeout(() => {

          copyButton.textContent = "复制URL";

        }, 2000);

      }

    } catch (error) {

      console.error(error);

    }

  });


  instagramButton?.addEventListener("click", () => {

    const dialog =
      document.createElement("div");


    dialog.innerHTML = `

      <div
        id="instagram-share-overlay"
        style="
          position:fixed;
          inset:0;
          z-index:9999;
          display:flex;
          align-items:center;
          justify-content:center;
          padding:24px;
          background:rgba(43,39,36,.55);
          backdrop-filter:blur(6px);
        "
      >

        <div
          style="
            width:100%;
            max-width:420px;
            padding:36px;
            border:1px solid #e2d8cb;
            border-radius:28px;
            background:#fffdfa;
            box-shadow:0 20px 60px rgba(0,0,0,.18);
            text-align:center;
          "
        >

          <p
            style="
              margin:0;
              font-family:'Cormorant Garamond',serif;
              font-size:14px;
              letter-spacing:.35em;
              color:#a58c65;
            "
          >
            SHARE
          </p>


          <h3
            style="
              margin:14px 0 0;
              font-family:'Shippori Mincho',serif;
              font-size:24px;
              color:#2b2724;
              font-weight:400;
            "
          >
            在Instagram上分享
          </h3>


          <p
            style="
              margin:20px 0 0;
              font-family:'Shippori Mincho',serif;
              font-size:14px;
              line-height:2;
              color:#625a52;
            "
          >
            复制此作品页面的URL<br>
            然后打开Instagram。
          </p>


          <button
            id="instagram-open"
            type="button"
            style="
              width:100%;
              margin-top:28px;
              padding:14px 20px;
              border:1px solid #d7c8b3;
              border-radius:999px;
              background:#2b2724;
              color:#fff;
              font-family:'Shippori Mincho',serif;
              font-size:15px;
              cursor:pointer;
            "
          >
            复制URL并打开Instagram
          </button>


          <button
            id="instagram-cancel"
            type="button"
            style="
              width:100%;
              margin-top:10px;
              padding:12px 20px;
              border:0;
              background:transparent;
              color:#8c8378;
              font-family:'Shippori Mincho',serif;
              font-size:14px;
              cursor:pointer;
            "
          >
            取消
          </button>

        </div>

      </div>

    `;


    document.body.appendChild(dialog);


    const overlay =
      document.getElementById(
        "instagram-share-overlay"
      );


    const openButton =
      document.getElementById(
        "instagram-open"
      );


    const cancelButton =
      document.getElementById(
        "instagram-cancel"
      );


    openButton?.addEventListener(
      "click",
      async () => {

        try {

          await navigator.clipboard.writeText(
            pageUrl
          );

        } catch (error) {

          console.error(error);

        }


        window.open(
          "https://www.instagram.com/",
          "_blank",
          "noopener,noreferrer"
        );


        overlay?.remove();

      }
    );


    cancelButton?.addEventListener(
      "click",
      () => {

        overlay?.remove();

      }
    );


    overlay?.addEventListener(
      "click",
      (event) => {

        if (event.target === overlay) {

          overlay.remove();

        }

      }
    );

  });

</script>



<style>

