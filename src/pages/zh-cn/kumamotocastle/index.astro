}


.gallery-frame:hover {

  background:

    linear-gradient(
      to right,
      transparent 0%,
      rgba(253, 164, 175, 0.9) 25%,
      rgba(252, 211, 77, 0.9) 50%,
      rgba(125, 211, 252, 0.9) 75%,
      transparent 100%
    );

}


@media (max-width:1100px) {

  section {

    overflow:
      hidden;

  }


}


