  aside {

    position:
      relative;

    top:
      auto;

  }


}


@media (max-width:768px) {

  section:first-child {

    height:
      760px;

  }

  h1 {

    font-size:
      44px !important;

    line-height:
      1.15;

  }

  h2 {

    font-size:
      32px !important;

  }

  /*
   * Hero animationは停止しない。
   * PC・スマホとも同じアニメーションを維持。
   */

  .gallery-frame {

    border-radius:
      1rem;

  }

  .gallery-frame img {

    border-radius:
      calc(1rem - 2px);

  }

}

</style>

</Layout>