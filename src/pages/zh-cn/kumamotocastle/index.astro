}


@keyframes heroFloat {

  0% {

    transform:
      scale(1.03)
      translateY(0);

  }

  50% {

    transform:
      scale(1.06)
      translateY(-18px);

  }

  100% {

    transform:
      scale(1.03)
      translateY(0);

  }

}


section {

  position:
    relative;

}


section::before {

