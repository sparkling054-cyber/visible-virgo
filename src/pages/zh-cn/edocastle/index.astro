<script>
  const pageUrl = "https://www.nishikinolab.net/zh-cn/edocastle/";

  const sharePhrases = [
    "找到这个了。",
    "这个莫名有点喜欢。",
    "看看这个。",
    "发现了个挺让人在意的东西。",
    "发现了这个。",
    "你知道这个吗？",
    "发现了个东西。",
    "原来还有这个。",
    "发现了个有点在意的东西。"
  ];

  const randomPhrase =
    sharePhrases[Math.floor(Math.random() * sharePhrases.length)];

  const shareText =
    `${randomPhrase} Minecraft 江户城 | WORKS`;

  const xShareButton = document.getElementById("x-share");
  const copyButton = document.getElementById("copy-url");
  const instagramButton = document.getElementById("instagram-share");

  if (xShareButton) {
    xShareButton.setAttribute(
      "href",
      `https://x.com/intent/post?text=${encodeURIComponent(shareText)}&url=${encodeURIComponent(pageUrl)}`
    );
  }

  copyButton?.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(pageUrl);

      if (copyButton) {
        copyButton.textContent = "已复制";

        setTimeout(() => {
          copyButton.textContent = "复制URL";
        }, 2000);
      }
    } catch (error) {
      console.error(error);
    }
  });

  instagramButton?.addEventListener("click", () => {

    const dialog = document.createElement("div");

    dialog.innerHTML = `
      <div
        id="instagram-share-overlay"
        style="
          position:fixed;
          inset:0;
          z-index:9999;
          display:flex;
          align-items:center;
          justify-content:center;
          padding:24px;
          background:rgba(43,39,36,.55);
          backdrop-filter:blur(6px);
        "
      >
        <div
          style="
            width:100%;
            max-width:420px;
            padding:36px;
            border:1px solid #e2d8cb;
            border-radius:28px;
            background:#fffdfa;
            box-shadow:0 20px 60px rgba(0,0,0,.18);
            text-align:center;
          "
        >

          <p
            style="
              margin:0;
              font-family:'Cormorant Garamond',serif;
              font-size:14px;
              letter-spacing:.35em;
              color:#a58c65;
            "
          >
            SHARE
          </p>

          <h3
            style="
              margin:14px 0 0;
              font-family:'Shippori Mincho',serif;
              font-size:24px;
              color:#2b2724;
              font-weight:400;
            "
          >
            在Instagram上分享
          </h3>

          <p
            style="
              margin:20px 0 0;
              font-family:'Shippori Mincho',serif;
              font-size:14px;
              line-height:2;
              color:#625a52;
            "
          >
            复制本作品页面的URL后<br>
            打开Instagram。
          </p>

          <button
            id="instagram-open"
            type="button"
            style="
              width:100%;
              margin-top:28px;
              padding:14px 20px;
              border:1px solid #d7c8b3;
              border-radius:999px;
              background:#2b2724;
              color:#fff;
              font-family:'Shippori Mincho',serif;
              font-size:15px;
              cursor:pointer;
            "
          >
            复制URL并打开Instagram
          </button>

          <button
            id="instagram-cancel"
            type="button"
            style="
              width:100%;
              margin-top:10px;
              padding:12px 20px;
              border:0;
              background:transparent;
              color:#8c8378;
              font-family:'Shippori Mincho',serif;
              font-size:14px;
              cursor:pointer;
            "
          >
            取消
          </button>

        </div>
      </div>
    `;

    document.body.appendChild(dialog);

    const overlay = document.getElementById("instagram-share-overlay");
    const openButton = document.getElementById("instagram-open");
    const cancelButton = document.getElementById("instagram-cancel");

    openButton?.addEventListener("click", async () => {

      try {
        await navigator.clipboard.writeText(pageUrl);
      } catch (error) {
        console.error(error);
      }

      window.open(
        "https://www.instagram.com/",
        "_blank",
        "noopener,noreferrer"
      );

      overlay?.remove();
    });

    cancelButton?.addEventListener("click", () => {
      overlay?.remove();
    });

    overlay?.addEventListener("click", (event) => {
      if (event.target === overlay) {
        overlay.remove();
      }
    });
  });
</script>

<style>

.work-hero{
  animation:heroFloat 12s ease-in-out infinite;
  transform-origin:center;
}

@keyframes heroFloat{

0%{
transform:scale(1.03) translateY(0);
}

50%{
transform:scale(1.06) translateY(-18px);
}

100%{
transform:scale(1.03) translateY(0);
}

}

section{
position:relative;
}

section::before{
content:"";
