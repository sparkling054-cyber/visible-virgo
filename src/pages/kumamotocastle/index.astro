          <p
            class="text-base tracking-[0.4em] text-[#a68b64]"
            style="font-family:'Cormorant Garamond',serif;"
          >
            DATA
          </p>


          <div class="mt-10 space-y-8">

            <div>
              <p class="text-base text-[#8c8378]">作品名</p>
              <p class="text-base">熊本城天守</p>
            </div>

            <div>
              <p class="text-base text-[#8c8378]">分類</p>
              <p class="text-base">和風城郭・天守</p>
            </div>

            <div>
              <p class="text-base text-[#8c8378]">建築時期</p>
              <p class="text-base">江戸時代初期</p>
            </div>

            <div>
              <p class="text-base text-[#8c8378]">所在地</p>
              <p class="text-base">
                〒860-0002 熊本県熊本市中央区本丸1-1
              </p>
            </div>

            <div>
              <p class="text-base text-[#8c8378]">築城年</p>
              <p class="text-base">慶長6年頃（1601年頃）</p>
            </div>

            <div>
              <p class="text-base text-[#8c8378]">築城主</p>
              <p class="text-base">加藤清正</p>
            </div>

            <div>
              <p class="text-base text-[#8c8378]">形式</p>
              <p class="text-base">連結式望楼型天守</p>
            </div>

            <div>
              <p class="text-base text-[#8c8378]">制作ソフト</p>
              <p class="text-base">Minecraft Java Edition 1.21.5</p>
            </div>

            <div>
              <p class="text-base text-[#8c8378]">作品区分</p>
              <p class="text-base">和風建築復元・再現</p>
            </div>

            <div>
              <p class="text-base text-[#8c8378]">制作状況</p>
              <p class="text-base">完成</p>
            </div>

          </div>

        </div>

      </aside>

    </div>


    <div class="mx-auto mt-32 max-w-6xl">

      <div class="flex items-center gap-5">

        <span class="h-px w-20 bg-[#caa14d]"></span>

        <p
          class="text-base tracking-[0.45em] text-[#a58c65]"
          style="font-family:'Cormorant Garamond',serif;"
        >
          GALLERY
        </p>

      </div>


      <h2
        class="mt-6 text-4xl"
        style="font-family:'Shippori Mincho',serif;"
      >
        展示写真
      </h2>


      <div class="gallery mt-12">

        <div class="gallery-frame">
          <img
            src="/images/kumamoto.jpg"
            alt="熊本城天守"
          />
        </div>

        <div class="gallery-frame">
          <img
            src="/images/kumamoto1.png"
            alt="熊本城天守"
          />
        </div>

        <div class="gallery-frame">
          <img
            src="/images/kumamoto2.png"
            alt="熊本城天守"
          />
        </div>

        <div class="gallery-frame">
          <img
            src="/images/kumamoto3.png"
            alt="熊本城天守"
          />
        </div>

      </div>

    </div>


    <div class="mt-24 flex flex-wrap gap-4">

      <a
        href="/works/"
        class="inline-flex rounded-full border border-[#d7c8b3] bg-white px-8 py-4 text-base transition hover:bg-[#2b2724] hover:text-white"
      >
        ← 作品一覧へ戻る
      </a>


      <a
        href="https://x.com/MikuNiki5471/status/1950147940971892883/photo/1"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex rounded-full border border-[#d7c8b3] bg-white px-8 py-4 text-base transition hover:bg-[#2b2724] hover:text-white"
      >
        もっと見る →
      </a>


      <a
        href="https://youtube.com/shorts/QzWMzN91y7E"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex rounded-full border border-[#d7c8b3] bg-white px-8 py-4 text-base transition hover:bg-[#2b2724] hover:text-white"
      >
        動画を見る →
      </a>


      <div class="mt-32 text-center w-full">

        <div class="flex items-center justify-center gap-5">

          <span class="h-px w-16 bg-[#caa14d]"></span>

          <p
            class="text-base tracking-[0.45em] text-[#a58c65]"
            style="font-family:'Cormorant Garamond',serif;"
          >
            SHARE
          </p>

          <span class="h-px w-16 bg-[#caa14d]"></span>

        </div>


        <h2
          class="mt-6 text-3xl text-[#2b2724]"
          style="font-family:'Shippori Mincho',serif;"
        >
          作品をシェア
        </h2>


        <div class="mt-8 flex justify-center gap-4 flex-wrap">

          <!-- X -->

          <a
            href="https://x.com/intent/post?text=%E9%8C%A6%E4%B9%83%E3%80%8C%E7%86%8A%E6%9C%AC%E5%9F%8E%E5%A4%A9%E5%AE%88%E9%96%A3%E3%80%8D%20%7C%20WORKS&url=https%3A%2F%2Fwww.nishikinolab.net%2Fkumamotocastle%2F"
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-full border border-[#d7c8b3] bg-white px-7 py-3 text-base hover:bg-[#2b2724] hover:text-white"
          >
            X
          </a>


          <!-- Instagram -->

          <button
            type="button"
            id="instagram-share"
            class="rounded-full border border-[#d7c8b3] bg-white px-7 py-3 text-base hover:bg-[#2b2724] hover:text-white"
          >
            Instagram
          </button>


          <!-- Copy -->

          <button
            type="button"
            id="copy-url"
            class="rounded-full border border-[#d7c8b3] bg-white px-7 py-3 text-base hover:bg-[#2b2724] hover:text-white"
          >
            URLをコピー
          </button>

        </div>

      </div>

    </div>

  </Container>

</section>


<script>

const pageUrl =
  "https://www.nishikinolab.net/kumamotocastle/";


const copyButton =
  document.getElementById("copy-url");


const instagramButton =
  document.getElementById("instagram-share");


copyButton?.addEventListener("click", async () => {

  try {

    await navigator.clipboard.writeText(pageUrl);

    if (copyButton) {

      copyButton.textContent = "コピーしました";

      setTimeout(() => {

        copyButton.textContent = "URLをコピー";

      }, 2000);

    }

  } catch (error) {

    console.error(error);

  }

});


instagramButton?.addEventListener("click", () => {

  const dialog =
    document.createElement("div");


  dialog.innerHTML = `

    <div
      id="instagram-share-overlay"
      style="
        position:fixed;
        inset:0;
        z-index:9999;
        display:flex;
        align-items:center;
        justify-content:center;
        padding:24px;
        background:rgba(43,39,36,.55);
        backdrop-filter:blur(6px);
      "
    >

      <div
        style="
          width:100%;
          max-width:420px;
          padding:36px;
          border:1px solid #e2d8cb;
          border-radius:28px;
          background:#fffdfa;
          box-shadow:0 20px 60px rgba(0,0,0,.18);
          text-align:center;
        "
      >

        <p
          style="
            margin:0;
            font-family:'Cormorant Garamond',serif;
            font-size:14px;
            letter-spacing:.35em;
            color:#a58c65;
          "
        >
          SHARE
        </p>


        <h3
          style="
            margin:14px 0 0;
            font-family:'Shippori Mincho',serif;
            font-size:24px;
            color:#2b2724;
            font-weight:400;
          "
        >
          Instagramでシェア
        </h3>


        <p
          style="
            margin:20px 0 0;
            font-family:'Shippori Mincho',serif;
            font-size:14px;
            line-height:2;
            color:#625a52;
          "
        >
          この作品ページのURLをコピーして<br>
          Instagramを開きます。
        </p>


        <button
          id="instagram-open"
          type="button"
          style="
            width:100%;
            margin-top:28px;
            padding:14px 20px;
            border:1px solid #d7c8b3;
            border-radius:999px;
            background:#2b2724;
            color:#fff;
            font-family:'Shippori Mincho',serif;
            font-size:15px;
            cursor:pointer;
          "
        >
          URLをコピーしてInstagramを開く
        </button>


        <button
          id="instagram-cancel"
          type="button"
          style="
            width:100%;
            margin-top:10px;
            padding:12px 20px;
            border:0;
            background:transparent;
            color:#8c8378;
            font-family:'Shippori Mincho',serif;
            font-size:14px;
            cursor:pointer;
          "
        >
          キャンセル
        </button>

      </div>

    </div>

  `;


  document.body.appendChild(dialog);


  const overlay =
    document.getElementById(
      "instagram-share-overlay"
    );


  const openButton =
    document.getElementById(
      "instagram-open"
    );


  const cancelButton =
    document.getElementById(
      "instagram-cancel"
    );


  openButton?.addEventListener(
    "click",
    async () => {

      try {

        await navigator.clipboard.writeText(
          pageUrl
        );

      } catch (error) {

        console.error(error);

      }


      window.open(
        "https://www.instagram.com/",
        "_blank",
        "noopener,noreferrer"
      );


      overlay?.remove();

    }
  );


  cancelButton?.addEventListener(
    "click",
    () => {

      overlay?.remove();

    }
  );


  overlay?.addEventListener(
    "click",
    (event) => {

      if (event.target === overlay) {

        overlay.remove();

      }

    }
  );

});

</script>


<style>

