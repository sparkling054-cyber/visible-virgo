</div>

    </div>

  </Container>

</section>

<style>

.work-hero{
  animation:heroFloat 12s ease-in-out infinite;
  transform-origin:center;
}

@keyframes heroFloat{

0%{
transform:scale(1.03) translateY(0);
}

50%{
transform:scale(1.06) translateY(-18px);
}

100%{
transform:scale(1.03) translateY(0);
}

}

.gallery{

display:grid;

grid-template-columns:repeat(2,minmax(0,1fr));

gap:1.5rem;

}

.gallery img{

display:block;

width:100%;

aspect-ratio:16/10;

object-fit:cover;

border-radius:1.25rem;

border:1px solid #ddd3c8;

background:#ece6dc;

transition:
transform .45s cubic-bezier(.22,1,.36,1),
box-shadow .45s;

}

.gallery img:hover{

transform:translateY(-8px) scale(1.02);

box-shadow:0 25px 60px rgba(0,0,0,.14);

}

section{

position:relative;

}

section::before{

content:"";

position:absolute;

left:0;

top:0;

width:100%;

height:100%;

pointer-events:none;

background-image:

radial-gradient(circle at 8% 10%,rgba(205,175,98,.08),transparent 18%),

radial-gradient(circle at 92% 82%,rgba(205,175,98,.06),transparent 22%);

}

aside{

position:sticky;

top:120px;

height:max-content;

}

a{

transition:.35s;

}

@media(max-width:1100px){

section{

overflow:hidden;

}

}

@media(max-width:900px){

.gallery{

grid-template-columns:1fr;

}

aside{

position:relative;

top:auto;

}

}

@media(max-width:768px){

section:first-child{

height:760px;

}

h1{

font-size:44px !important;

line-height:1.15;

}

h2{

font-size:32px !important;

}

.work-hero{

animation:none;

}

.gallery img{

border-radius:1rem;

}

}

</style>

</Layout>

