---
import Layout from "../../../layouts/Layout.astro";
import Container from "../../../components/common/Container.astro";
---

<Layout
  title="錦乃｜ギャラリー｜PROFILE"
  description="錦乃のキャラクタービジュアル、設定画、イラスト、ギャラリーを掲載。日本文化や歴史をテーマに活動するクリエイター錦乃の世界観やデザインをご覧いただけます。"
>


  <!-- Scroll -->

  <div class="absolute bottom-16 right-12 z-30 flex flex-col items-center">

    <div class="h-20 w-px bg-white/70"></div>

    <span class="mt-4 text-xs tracking-[0.45em] text-white">
      SCROLL
    </span>

  </div>



<section class="relative bg-[#f8f6f2] overflow-hidden works-detail">

  <!-- Washi Background -->

  <img
    src="/images/washi-bg.png"
    alt=""
    class="absolute right-0 top-0 h-full w-full opacity-[0.3] pointer-events-none select-none -z-0"
  />


  <Container class="py-32 relative z-10">

    <!-- Gallery -->

    <div class="mx-auto max-w-9xl">

      <div class="flex items-center gap-5">

        <span class="h-px w-20 bg-[#caa14d]"></span>

        <p
          class="tracking-[0.45em] text-[#a58c65]"
          style="font-family:'Cormorant Garamond',serif;"
        >
          GALLERY
        </p>

      </div>


      <h2
        class="mt-6 text-4xl"
        style="font-family:'Shippori Mincho',serif;"
      >
        新ビジュアルアート展示室
      </h2>


      <div class="gallery mt-12">

        <img
          src="/images/profile.jpg"
          alt="にしきのアイコン"
        >

        <img
          src="/images/gallery1.png"
          alt=""
        >

        <img
          src="/images/nishikino-setting.png"
          alt="設定画"
        >

        <img
          src="/images/nishikino-setting1.png"
          alt=""
        >

        <img
          src="/images/contact-bg.png"
          alt=""
        >

        <img
          src="/images/about-bg.png"
          alt=""
        >

        <img
          src="/images/edb6eded-c0ea-4c8c-8185-8c5d74303269.png"
          alt=""
        >
         <img
          src="/images/gallery-bg.png"
          alt=""
        >

      </div>


      <!-- Back -->

      <div class="mt-24">

      
       
        <a
          href="/profile/"
          class="inline-flex rounded-full border border-[#d7c8b3] bg-white px-8 py-4 transition hover:bg-[#2b2724] hover:text-white"
        >
          プロフィール →
        </a>

      </div>

      <!-- Share -->

      <div class="mt-32 text-center">

        <div class="flex items-center justify-center gap-5">

          <span class="h-px w-16 bg-[#caa14d]"></span>

          <p
            class="tracking-[0.45em] text-[#a58c65]"
            style="font-family:'Cormorant Garamond',serif;"
          >
            SHARE
          </p>

          <span class="h-px w-16 bg-[#caa14d]"></span>

        </div>


        <h2
          class="mt-6 text-3xl text-[#2b2724]"
          style="font-family:'Shippori Mincho',serif;"
        >
          シェア
        </h2>


        <div class="mt-8 flex justify-center gap-4 flex-wrap">

          <a
            id="x-share"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-full border border-[#d7c8b3] bg-white px-7 py-3 text-sm hover:bg-[#2b2724] hover:text-white"
          >
            X
          </a>


          <button
            type="button"
            id="instagram-share"
            class="rounded-full border border-[#d7c8b3] bg-white px-7 py-3 text-sm hover:bg-[#2b2724] hover:text-white"
          >
            Instagram
          </button>


          <button
            type="button"
            id="copy-url"
            class="rounded-full border border-[#d7c8b3] bg-white px-7 py-3 text-sm hover:bg-[#2b2724] hover:text-white"
          >
            URLをコピー
          </button>

        </div>

      </div>

    </div>

  </Container>

</section>


<script>
  const sharePhrases = [
    "これ見つけた。",
    "これ、なんか好き。",
    "これちょっと見て。",
    "なんか気になるの見つけた。",
    "こんなの見っけた。",
    "これ知ってる？",
    "なんか見つけた。",
    "こんなのあった。",
    "ちょっと気になるもの見つけたかも。"
  ];

  const randomPhrase =
    sharePhrases[Math.floor(Math.random() * sharePhrases.length)];

  const pageUrl = "https://www.nishikinolab.net/profile/gallery";

  const shareText =
    `${randomPhrase} Minecraft ギャラリー | PROFILE`;

  const xShareButton = document.getElementById("x-share");
  const copyButton = document.getElementById("copy-url");
  const instagramButton = document.getElementById("instagram-share");

  if (xShareButton) {
    const xShareUrl =
      `https://x.com/intent/post?text=${encodeURIComponent(shareText)}&url=${encodeURIComponent(pageUrl)}`;

    xShareButton.setAttribute("href", xShareUrl);
  }


  copyButton?.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(pageUrl);

      if (copyButton) {
        copyButton.textContent = "コピーしました";

        setTimeout(() => {
          copyButton.textContent = "URLをコピー";
        }, 2000);
      }
    } catch (error) {
      console.error(error);
    }
  });


  instagramButton?.addEventListener("click", () => {

    const dialog = document.createElement("div");

    dialog.innerHTML = `
      <div
        id="instagram-share-overlay"
        style="
          position:fixed;
          inset:0;
          z-index:9999;
          display:flex;
          align-items:center;
          justify-content:center;
          padding:24px;
          background:rgba(43,39,36,.55);
          backdrop-filter:blur(6px);
        "
      >
        <div
          style="
            width:100%;
            max-width:420px;
            padding:36px;
            border:1px solid #e2d8cb;
            border-radius:28px;
            background:#fffdfa;
            box-shadow:0 20px 60px rgba(0,0,0,.18);
            text-align:center;
          "
        >

          <p
            style="
              margin:0;
              font-family:'Cormorant Garamond',serif;
              font-size:14px;
              letter-spacing:.35em;
              color:#a58c65;
            "
          >
            SHARE
          </p>

          <h3
            style="
              margin:14px 0 0;
              font-family:'Shippori Mincho',serif;
              font-size:24px;
              color:#2b2724;
              font-weight:400;
            "
          >
            Instagramでシェア
          </h3>

          <p
            style="
              margin:20px 0 0;
              font-family:'Shippori Mincho',serif;
              font-size:14px;
              line-height:2;
              color:#625a52;
            "
          >
            このギャラリーページのURLをコピーして<br>
            Instagramを開きます。
          </p>

          <button
            id="instagram-open"
            type="button"
            style="
              width:100%;
              margin-top:28px;
              padding:14px 20px;
              border:1px solid #d7c8b3;
              border-radius:999px;
              background:#2b2724;
              color:#fff;
              font-family:'Shippori Mincho',serif;
              font-size:15px;
              cursor:pointer;
            "
          >
            URLをコピーしてInstagramを開く
          </button>

          <button
            id="instagram-cancel"
            type="button"
            style="
              width:100%;
              margin-top:10px;
              padding:12px 20px;
              border:0;
              background:transparent;
              color:#8c8378;
              font-family:'Shippori Mincho',serif;
              font-size:14px;
              cursor:pointer;
            "
          >
            キャンセル
          </button>

        </div>
      </div>
    `;

    document.body.appendChild(dialog);

    const overlay = document.getElementById("instagram-share-overlay");
    const openButton = document.getElementById("instagram-open");
    const cancelButton = document.getElementById("instagram-cancel");


    openButton?.addEventListener("click", async () => {

      try {
        await navigator.clipboard.writeText(pageUrl);
      } catch (error) {
        console.error(error);
      }

      window.open(
        "https://www.instagram.com/",
        "_blank",
        "noopener,noreferrer"
      );

      overlay?.remove();
    });


    cancelButton?.addEventListener("click", () => {
      overlay?.remove();
    });


    overlay?.addEventListener("click", (event) => {
      if (event.target === overlay) {
        overlay.remove();
      }
    });

  });
</script>

</Layout>