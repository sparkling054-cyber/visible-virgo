</section>

<script>
  const sharePhrases = [
    "이거 찾았다.",
    "이거 왠지 좋다.",
    "이거 좀 봐.",
    "뭔가 신경 쓰이는 걸 찾았다.",
    "이런 거 찾았다.",
    "이거 알아?",
    "뭔가 찾았다.",
    "이런 것도 있네.",
    "좀 눈길 가는 걸 찾았다.",
  ];

  const sharePhrase =
    sharePhrases[
      Math.floor(Math.random() * sharePhrases.length)
    ];

  const shareText =
    `${sharePhrase} Minecraft 에도성 | WORKS`;

  const pageUrl =
    "https://www.nishikinolab.net/ko/edocastle/";

  const xShareButton =
    document.getElementById("x-share");

  if (xShareButton) {
    xShareButton.setAttribute(
      "href",
      `https://x.com/intent/post?text=${encodeURIComponent(shareText)}&url=${encodeURIComponent(pageUrl)}`
    );
  }

  const copyButton =
    document.getElementById("copy-url");

  const instagramButton =
    document.getElementById("instagram-share");

  copyButton?.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(pageUrl);

      if (copyButton) {
        copyButton.textContent = "복사되었습니다";

        setTimeout(() => {
          copyButton.textContent = "URL 복사";
        }, 2000);
      }
    } catch (error) {
      console.error(error);
    }
  });

  instagramButton?.addEventListener("click", () => {

    const dialog = document.createElement("div");

    dialog.innerHTML = `
      <div
        id="instagram-share-overlay"
        style="
          position:fixed;
          inset:0;
          z-index:9999;
          display:flex;
          align-items:center;
          justify-content:center;
          padding:24px;
          background:rgba(43,39,36,.55);
          backdrop-filter:blur(6px);
        "
      >
        <div
          style="
            width:100%;
            max-width:420px;
            padding:36px;
            border:1px solid #e2d8cb;
            border-radius:28px;
            background:#fffdfa;
            box-shadow:0 20px 60px rgba(0,0,0,.18);
            text-align:center;
          "
        >

          <p
            style="
              margin:0;
              font-family:'Cormorant Garamond',serif;
              font-size:14px;
              letter-spacing:.35em;
              color:#a58c65;
            "
          >
            SHARE
          </p>

          <h3
            style="
              margin:14px 0 0;
              font-family:'Shippori Mincho',serif;
              font-size:24px;
              color:#2b2724;
              font-weight:400;
            "
          >
            Instagram에서 공유
          </h3>

          <p
            style="
              margin:20px 0 0;
              font-family:'Shippori Mincho',serif;
              font-size:14px;
              line-height:2;
              color:#625a52;
            "
          >
            이 작품 페이지의 URL을 복사한 후<br>
            Instagram을 엽니다.
          </p>

          <button
            id="instagram-open"
            type="button"
            style="
              width:100%;
              margin-top:28px;
              padding:14px 20px;
              border:1px solid #d7c8b3;
              border-radius:999px;
              background:#2b2724;
              color:#fff;
              font-family:'Shippori Mincho',serif;
              font-size:15px;
              cursor:pointer;
            "
          >
            URL 복사 후 Instagram 열기
          </button>

          <button
            id="instagram-cancel"
            type="button"
            style="
              width:100%;
              margin-top:10px;
              padding:12px 20px;
              border:0;
              background:transparent;
              color:#8c8378;
              font-family:'Shippori Mincho',serif;
              font-size:14px;
              cursor:pointer;
            "
          >
            취소
          </button>

        </div>
      </div>
    `;

    document.body.appendChild(dialog);

    const overlay =
      document.getElementById("instagram-share-overlay");

    const openButton =
      document.getElementById("instagram-open");

    const cancelButton =
      document.getElementById("instagram-cancel");

    openButton?.addEventListener("click", async () => {

      try {
        await navigator.clipboard.writeText(pageUrl);
      } catch (error) {
        console.error(error);
      }

      window.open(
        "https://www.instagram.com/",
        "_blank",
        "noopener,noreferrer"
      );

      overlay?.remove();
    });

    cancelButton?.addEventListener("click", () => {
      overlay?.remove();
    });

    overlay?.addEventListener("click", (event) => {
      if (event.target === overlay) {
        overlay.remove();
      }
    });
  });
</script>

