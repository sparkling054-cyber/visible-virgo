sm:mt-5
sm:text-sm
sm:leading-7

lg:text-base
lg:leading-8

max-sm:mt-3
max-sm:text-[11px]
max-sm:leading-5
"
style="font-family:'Shippori Mincho',serif;"
>
{item.text}
</p>


</article>

))
}

</div>


</div>

</section>




