---
import Layout from "../../../../layouts/Layout.astro";

const categories = [
  "개인・크리에이터",
  "기업・법인",
  "지자체・문화기관",
  "미디어・이벤트",
  "연구・자료 협력",
  "기타"
];

const purposes = [
  "YouTube・영상 제작",
  "SNS・콘텐츠 제작",
  "크리에이터 협업",
  "Minecraft・디지털 제작",
  "역사・성곽・문화 관련",
  "감수・자료 제공",
  "미디어 출연・취재",
  "기업・도시・전문기관・지자체 프로젝트",
  "기타"
];
---

<Layout
  title="錦乃니시키노｜문의"
  description=""
>

<section
  class="relative h-[650px] overflow-hidden"
>

<img
  src="/images/contact-form-bg.png"
  alt="문의 배경"
  class="form-image absolute inset-0 h-full w-full object-cover select-none"
  draggable="false"
/>

<div
  class="absolute inset-0 bg-black/20"
></div>

<div
  class="relative z-10 flex h-full items-center justify-center px-8 text-center text-white"
>

<div
  class="form-reveal"
>

<p
  class="tracking-[0.45em] text-sm"
>
CONTACT FORM
</p>

<h1
  class="form-title mt-6 text-6xl"
  style="font-family:'Cormorant Garamond',serif;"
>
상담・문의
</h1>

<p
  class="mt-8 leading-9"
  style="font-family:'Shippori Mincho',serif;"
>
「이런 것도 부탁드릴 수 있을까요?」<br><br>

그런 한마디로 시작해도 괜찮습니다.<br>

아직 구체적인 내용이 정해지지 않았더라도,<br>
부담 없이 이야기를 들려주세요.
</p>

</div>

</div>

</section>

<section
class="bg-[#faf8f3] py-32"
>

<div
class="mx-auto max-w-5xl px-8"
>

<div
class="form-reveal mb-20 text-center"
>

<p
class="tracking-[0.35em] text-sm text-neutral-500"
>
MESSAGE
</p>

<h2
class="form-subtitle mt-5 text-5xl text-neutral-900"
style="font-family:'Cormorant Garamond',serif;"
>
편하게 말씀해주세요.
</h2>

<p
class="mx-auto mt-8 max-w-3xl leading-9 text-neutral-700"
style="font-family:'Shippori Mincho',serif;"
>

제작 의뢰, 기획 상담, 협업 등,<br>
아직 구체적인 내용이 정해지지 않은 단계에서도 환영합니다.

<br><br>

「이런 것을 할 수 있다면 재미있을 것 같다」<br><br>

그런 상상에서부터 함께 하나의 형태로 만들어갈 수 있다면 기쁠 것 같습니다.

</p>

</div>

<form
action="/api/contact"
method="POST"
class="form-card form-reveal rounded-[2.5rem] border border-white bg-white/80 p-10 shadow-xl backdrop-blur-md md:p-14"
>

<input
type="hidden"
name="locale"
value="ko"
/>

<div
class="hidden"
aria-hidden="true"
>

<label>
Leave this field empty
</label>

<input
type="text"
name="website"
/>

</div>

<div
class="grid gap-8"
>

<div>

<label
for="category"
class="block text-sm tracking-widest text-neutral-600"
>
문의하시는 분
</label>

<select
id="category"
name="category"
required
class="form-field mt-4 w-full rounded-2xl border border-neutral-200 bg-white px-5 py-4 text-neutral-800 outline-none transition focus:border-neutral-800"
>

<option value="">
선택해주세요
</option>

{
categories.map((category)=>(
<option value={category}>
{category}
</option>
))
}

</select>

</div>

<div>

<label
for="name"
class="block text-sm tracking-widest text-neutral-600"
>
이름
</label>

<input
id="name"
name="name"
type="text"
required
maxlength="50"
placeholder="이름 또는 활동명을 입력해주세요"
class="form-field mt-4 w-full rounded-2xl border border-neutral-200 bg-white px-5 py-4 text-neutral-800 outline-none transition focus:border-neutral-800"
/>

</div>

<div>

<label
for="sns"
class="block text-sm tracking-widest text-neutral-600"
>
SNS・웹사이트 (선택)
</label>

<input
id="sns"
name="sns"
type="url"
placeholder="YouTube・X・웹사이트 등의 URL"
class="form-field mt-4 w-full rounded-2xl border border-neutral-200 bg-white px-5 py-4 text-neutral-800 outline-none transition focus:border-neutral-800"
/>

</div>

<div>

<label
for="email"
class="block text-sm tracking-widest text-neutral-600"
>
이메일 주소
</label>

<input
id="email"
name="email"
type="email"
required
placeholder="example@example.com"
class="form-field mt-4 w-full rounded-2xl border border-neutral-200 bg-white px-5 py-4 text-neutral-800 outline-none transition focus:border-neutral-800"
/>

</div>

<div>

<label
for="organization"
class="block text-sm tracking-widest text-neutral-600"
>
법인・단체명 (선택)
</label>

<input
id="organization"
name="organization"
type="text"
maxlength="100"
placeholder="기업명・단체명 등을 입력해주세요"
class="form-field mt-4 w-full rounded-2xl border border-neutral-200 bg-white px-5 py-4 text-neutral-800 outline-none transition focus:border-neutral-800"
/>

</div>

<div>

<label
for="purpose"
class="block text-sm tracking-widest text-neutral-600"
>
문의 내용
</label>

<select
id="purpose"
name="purpose"
required
class="form-field mt-4 w-full rounded-2xl border border-neutral-200 bg-white px-5 py-4 text-neutral-800 outline-none transition focus:border-neutral-800"
>

<option value="">
선택해주세요
</option>

{
purposes.map((purpose)=>(
<option value={purpose}>
{purpose}
</option>
))
}

</select>

</div>

<div
id="other-purpose-area"
class="hidden"
>

<label
for="otherPurpose"
class="block text-sm tracking-widest text-neutral-600"
>
문의 내용 (자유 입력)
</label>

<input
id="otherPurpose"
name="otherPurpose"
type="text"
maxlength="200"
placeholder="문의 내용을 자유롭게 입력해주세요"
class="form-field mt-4 w-full rounded-2xl border border-neutral-200 bg-white px-5 py-4 text-neutral-800 outline-none transition focus:border-neutral-800"
/>

</div>

<div>

<label
for="message"
class="block text-sm tracking-widest text-neutral-600"
>
문의 내용 상세
</label>

<textarea
id="message"
name="message"
required
maxlength="2000"
rows="8"
placeholder="상담 내용이나 실현하고 싶은 것 등을 아시는 범위에서 작성해주세요.

아직 구체적인 내용이 정해지지 않은 단계에서도 괜찮습니다."
class="form-field mt-4 w-full rounded-2xl border border-neutral-200 bg-white px-5 py-4 leading-8 text-neutral-800 outline-none transition focus:border-neutral-800"
></textarea>

<p
class="mt-3 text-xs text-neutral-500"
>
최대 2000자까지 입력할 수 있습니다.
</p>

</div>

<div
class="pt-8 text-center"
>

<button
type="submit"
class="form-submit inline-flex h-40 w-40 items-center justify-center rounded-full border border-neutral-900 bg-white text-lg transition duration-500 hover:-translate-y-2 hover:shadow-2xl"
>

보내기

</button>

</div>

</div>

</form>

</div>

</section>

<section
class="bg-white py-24"
>

<div
class="mx-auto max-w-5xl px-8 text-center"
>

<div
class="form-reveal"
>

</div>

<a
href="/ko/contact/"
class="form-reveal mt-16 inline-flex rounded-full border border-neutral-800 px-10 py-4 transition hover:bg-neutral-900 hover:text-white"
>
CONTACT 페이지로 돌아가기
</a>

</div>

</section>

<style>

.form-image{

animation:formFloat 12s ease-in-out infinite;
transform-origin:center;

}

@keyframes formFloat{

0%{transform:scale(1.03) translateY(0);}
50%{transform:scale(1.06) translateY(-18px);}
100%{transform:scale(1.03) translateY(0);}

}

.form-reveal{

opacity:0;

transform:translateY(60px) scale(.97);

transition:
opacity .9s cubic-bezier(.22,1,.36,1),
transform .9s cubic-bezier(.22,1,.36,1);

}

.form-show{

animation:formBounce .9s cubic-bezier(.22,1,.36,1) forwards;

}

@keyframes formBounce{

0%{
opacity:0;
transform:translateY(60px) scale(.97);
}

70%{
opacity:1;
transform:translateY(-8px) scale(1.02);
}

100%{
opacity:1;
transform:translateY(0) scale(1);
}

}

.hidden{
display:none;
}


@media (max-width:640px){

.form-title{

font-size:2.1rem;

}

.form-subtitle{

font-size:2.3rem;

}

.form-card{

padding:1.5rem;

border-radius:1.8rem;

}

.form-field{

font-size:.92rem;

padding:.85rem 1rem;

}

.form-submit{

width:7.5rem;
height:7.5rem;
font-size:1rem;

}

}

</style>

<script>

const observer=new IntersectionObserver((entries)=>{

entries.forEach((entry)=>{

if(!entry.isIntersecting)return;

entry.target.classList.add("form-show");

observer.unobserve(entry.target);

});

},{
threshold:0.18
});

document.querySelectorAll(".form-reveal").forEach((element)=>{

observer.observe(element);

});

const purposeSelect=document.getElementById("purpose");
const otherArea=document.getElementById("other-purpose-area");
const otherInput=document.getElementById("otherPurpose");

function toggleOtherPurpose(){

if(
purposeSelect &&
otherArea &&
otherInput &&
purposeSelect.value==="기타"
){

otherArea.classList.remove("hidden");
otherInput.required=true;

}else if(
otherArea &&
otherInput
){

otherArea.classList.add("hidden");
otherInput.required=false;
otherInput.value="";

}

}

toggleOtherPurpose();

if(purposeSelect){
purposeSelect.addEventListener("change",toggleOtherPurpose);
}

</script>

</Layout>